# Every setting LoverBaazar reads. This file is committed and the repo is public, so keep real values out of it.
#
# Local: nothing here is needed. ./scripts/dev.sh sets up the database, the API and the
# admin token by itself. Copy this file to .env only to try an optional service locally:
#     cp .env.example .env
#
# Production: don't put these in a file. Each one goes in the dashboard named in its
# section, and docs/go-live.md walks through them. Never commit a real value.

# --- Render: the API (Dashboard > your service > Environment) ---------------------------
# Required. The API won't start without the two secrets (32+ characters each).
# Use the Neon pooled connection string here.
DATABASE_URL='postgres://USER:PASSWORD@HOST/DB?sslmode=require'
# Generate with: openssl rand -hex 32. This is the password for /admin/. Save it safely.
# The local token is refused here: the API will not start with it.
ADMIN_TOKEN=
# Generate with: openssl rand -hex 32. Must match the Worker's ORIGIN_SECRET below.
ORIGIN_SECRET=

# Optional. Each feature stays off until its values are set.
# All images (cloudinary.com, free plan). Also needed by scripts/images_to_cloudinary.py
CLOUDINARY_CLOUD=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=
# Emails to the shop and customers about orders (brevo.com, free plan)
BREVO_KEY=
SHOP_EMAIL=
ADMIN_EMAIL=
# Optional monitored reply address for order emails. Use ADMIN_EMAIL for incoming order alerts.
SHOP_REPLY_TO=
# Optional controlled test address, including preview. Customer receipts and order status emails default to enabled in production.
BREVO_TEST_EMAIL=
CUSTOMER_ORDER_EMAIL=true
# Application recipient attempt budget, including retries, over a UTC day. Max 240.
ORDER_EMAIL_DAILY_LIMIT=240
SITE_URL=
# The Publish button in admin (a fine-grained token with Contents: Read and write)
GITHUB_REPO=YOUR-NAME/loverbaazar
GITHUB_TOKEN=
# Bot check at checkout (secret key, see PUBLIC_TURNSTILE_SITE below)
TURNSTILE_SECRET=

# --- Cloudflare: the Worker ---------------------------------------------------------------
# ORIGIN_SECRET is set with: npx wrangler secret put ORIGIN_SECRET
# API_ORIGIN is set in apps/store/wrangler.jsonc. It is an address, not a secret.

# --- GitHub Actions (repo Settings > Secrets and variables > Actions) ---------------------
# Secrets tab: CLOUDFLARE_API_TOKEN, CLOUDFLARE_ACCOUNT_ID, BACKUP_DATABASE_URL, BACKUP_PASSPHRASE, RENDER_API_KEY
# Variables tab: RENDER_SERVICE_ID (srv-…), COORDINATED_RELEASES=true after Render Auto-Deploy is Off.
# Where a Publish reads products from: https://your-shop/api/catalog
CATALOG_URL=
# Bot check at checkout (site key, public by design)
TURNSTILE_SITE=

# --- Set automatically. Don't set these yourself ------------------------------------------
# PORT                  Render sets it, dev.sh uses 8080
# RENDER_GIT_COMMIT     Render sets it automatically; reported by /api/ready and release verification
# DEV                   Local mode: relaxes secure cookies and rate limits. Never on Render
# LOCAL_UPLOADS         dev.sh only: saves uploads on this computer instead of Cloudinary
# DEV_BUILD_DIR         dev.sh only: makes Publish rebuild locally
# PUBLIC_TURNSTILE_SITE The build's name for TURNSTILE_SITE
# TEST_DATABASE_URL     Tests only. They erase every table, so local lb_test databases only

# Foundation release/environment controls (tasks 1–8)
# Render: APP_ENV=production (default); preview suppresses all outgoing email.
APP_ENV=production
# Optional aggregate checkout logs. Set to the exact production hostname after cutover.
CHECKOUT_METRICS_HOST=
# Render: same public site key used by the production build; required with secret.
# TURNSTILE_SITE is also a GitHub Actions variable as documented above.
# Render + GitHub Actions secret: independently generated 64-hex token, only for
# preparing code releases from already published editorial content. Never ADMIN_TOKEN.
PUBLISH_TOKEN=
# GitHub Actions variables: STORE_ENV=preview until launch; then production.
STORE_ENV=preview
# Optional once production is verified. Enable the scheduled published-only price and stock refresh.
SEO_REFRESH_ENABLED=false
# Build canonical origin; API's SITE_URL remains its email-link setting.
SITE_ORIGIN=https://loverbaazar.com
# Actual deployed host used to verify /release.json before acknowledging Publish.
STORE_URL=
# BUILD_ID, BUILD_KEY, BUILD_ENV, BUILD_REVISION and DEPLOY_RENDER are set by the workflow (dev.sh sets BUILD_ENV=local).
# BUILD_OUTPUT, BUILD_PUBLIC_DIR and LB_ISOLATED/LB_API_PORT/LB_STORE_PORT/LB_DB_PORT are local tooling only.

# Offline catalog CLI only, for a dedicated local/preview target stopped for migration.
# Do not enable this in a hosting dashboard. A reviewed plan/approval is still required.
MIGRATION_MAINTENANCE=0
