# Every setting LoverBaazar reads.
#
# Local: nothing here is needed. ./scripts/dev.sh sets up the database, the API and the
# admin token by itself. Copy this file to .env only to try an optional service locally:
#     cp .env.example .env
#
# Production: don't put these in a file. Each one goes in the dashboard named in its
# section, and docs/go-live.md walks through them. Never commit a real value.

# --- Render: the API (Dashboard > your service > Environment) ---------------------------
# Required. The API won't start without the two secrets (32+ characters each).
# Use the Neon pooled connection string here.
DATABASE_URL='postgres://USER:PASSWORD@HOST/DB?sslmode=require'
# Generate with: openssl rand -hex 32. This is the password for /admin/. Save it safely.
# The local token is refused here: the API will not start with it.
ADMIN_TOKEN=
# Generate with: openssl rand -hex 32. Must match the Worker's ORIGIN_SECRET below.
ORIGIN_SECRET=

# Optional. Each feature stays off until its values are set.
# All images (cloudinary.com, free plan). Also needed by scripts/images_to_cloudinary.py
CLOUDINARY_CLOUD=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=
# Emails to the shop about new orders and messages (brevo.com, free plan)
BREVO_KEY=
SHOP_EMAIL=
# The Publish button in admin (a fine-grained token with Contents: Read and write)
GITHUB_REPO=YOUR-NAME/loverbaazar
GITHUB_TOKEN=
# Bot check at checkout (secret key, see PUBLIC_TURNSTILE_SITE below)
TURNSTILE_SECRET=

# --- Cloudflare: the Worker ---------------------------------------------------------------
# ORIGIN_SECRET is set with: npx wrangler secret put ORIGIN_SECRET
# API_ORIGIN and IMAGE_BASE are set in apps/store/wrangler.jsonc. They are addresses, not secrets.

# --- GitHub Actions (repo Settings > Secrets and variables > Actions) ---------------------
# Secrets tab: CLOUDFLARE_API_TOKEN, CLOUDFLARE_ACCOUNT_ID, BACKUP_DATABASE_URL, BACKUP_PASSPHRASE
# Variables tab:
# Where a Publish reads products from: https://your-shop/api/catalog
CATALOG_URL=
# Bot check at checkout (site key, public by design)
TURNSTILE_SITE=

# --- Set automatically. Don't set these yourself ------------------------------------------
# PORT                  Render sets it, dev.sh uses 8080
# DEV                   Local mode: relaxes secure cookies and rate limits. Never on Render
# LOCAL_UPLOADS         dev.sh only: saves uploads on this computer instead of Cloudinary
# DEV_BUILD_DIR         dev.sh only: makes Publish rebuild locally
# PUBLIC_TURNSTILE_SITE The build's name for TURNSTILE_SITE
# TEST_DATABASE_URL     Tests only. They erase every table, so local databases only
