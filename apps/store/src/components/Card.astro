---
import { cardSizes, responsiveImage } from "../lib/image-delivery.mjs";
import { taka, off, attributeValues, languageOf } from "../lib/shop";
const { p, eager, hidden = false } = Astro.props;
const d = off(p);
const photo = responsiveImage(p.images[0]?.src, p.images[0]?.thumb, [160, 320, 640]);
---

<article class="card" data-card data-name={p.name.toLowerCase()} data-price={p.price} data-id={p.id} data-stocked={p.inStock ? "1" : "0"} data-brands={JSON.stringify(attributeValues(p,"brand"))} data-colors={JSON.stringify(attributeValues(p,"color"))} hidden={hidden}>
  <a href={`/product/${p.slug}/`} class="thumb">
    <img
      {...photo}
      sizes={photo.srcset ? cardSizes : undefined}
      alt={p.images[0]?.alt || p.name}
      loading={eager ? "eager" : "lazy"}
      decoding="async"
      width="300"
      height="300"
    />
    <span class="badge" data-off={p.id} hidden={d === 0}>
      -{d}%
    </span>
  </a>
  <button class="heart" data-wish={p.id} aria-label={`Save ${p.name} to wishlist`} aria-pressed="false">
    ♥
  </button>
  <div class="body">
    <a href={`/product/${p.slug}/`} class="name" lang={languageOf(p.name)}>
      {p.name}
    </a>
    <div class="price" data-price-for={p.id}>
      <b>{taka(p.price)}</b>
      {p.regular > p.price && <s>{taka(p.regular)}</s>}
    </div>
    <span class="card-stock" data-stock-for={p.id}>{p.inStock ? "In stock" : "Sold out"}</span>
    <button class="btn small" data-add={p.id} data-label="Add to cart" disabled={!p.inStock}>
      {p.inStock ? "Add to cart" : "Sold out"}
    </button>
  </div>
</article>
