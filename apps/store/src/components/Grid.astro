---
import Card from "./Card.astro";
const { items } = Astro.props;
---
<div class="tools"><span><b data-count>{items.length}</b> products</span>
  <select data-sort aria-label="Sort"><option value="">Latest</option><option value="asc">Price: low to high</option><option value="desc">Price: high to low</option><option value="name">Name</option></select></div>
<div class="grid" data-grid>{items.map((p: any, i: number) => <Card p={p} eager={i < 4} />)}</div>
<button class="btn ghost more" data-more hidden>Show more</button>
