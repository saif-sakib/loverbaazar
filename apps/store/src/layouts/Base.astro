---
import "@fontsource-variable/plus-jakarta-sans";
import "../styles/site.css";
import { MENU, SITE, LIVE, pages, catUrl, telOf, waOf, siteUrl } from "../lib/shop";
const { title, description = SITE.description, image, noindex, type = "website" } = Astro.props;
const full = title ? `${title} | ${SITE.name}` : `${SITE.name} | ${SITE.tagline}`;
const canon = new URL(Astro.url.pathname, Astro.site);
const parts = SITE.name.split(/(?=[A-Z])/);
const logoEnd = parts.length > 1 ? parts.pop() : "";
const logoStart = parts.join("");
const absUrl = (u: string) => (u.startsWith("http") ? u : siteUrl(u));
const defaultOg = !image && !SITE.logo;
const ogImage = image ? absUrl(image) : absUrl(SITE.logo || "/og-image.jpg");
const payments = LIVE.payments.filter((p: any) => p.enabled);
const org = {
  "@context": "https://schema.org",
  "@type": "Store",
  name: SITE.name,
  url: Astro.site?.href,
  logo: absUrl(SITE.logo || "/logo/primary-logo.jpg"),
  image: ogImage,
  telephone: telOf(SITE.phone),
  email: SITE.email,
  priceRange: "৳৳",
  currenciesAccepted: "BDT",
  paymentAccepted: payments.map((p: any) => p.label).join(", ") || undefined,
  address: SITE.address
    ? {
        "@type": "PostalAddress",
        streetAddress: SITE.address,
        addressLocality: "Jashore",
        addressCountry: "BD",
      }
    : undefined,
  sameAs: [SITE.facebook, SITE.youtube].filter(Boolean),
};
const webSiteLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: SITE.name,
  url: siteUrl("/"),
  potentialAction: {
    "@type": "SearchAction",
    target: `${siteUrl("/search/")}?q={search_term_string}`,
    "query-input": "required name=search_term_string",
  },
};
const standardSlugs = new Set(["about-us", "how-to-buy", "contact-us", "privacy-policy", "terms-conditions"]);
const extraPages = pages.filter((p: any) => !p.draft && !standardSlugs.has(p.slug));
---

<!doctype html>
<html lang="en" data-phone={SITE.phone}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{full}</title>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={noindex
        ? "noindex, nofollow"
        : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"}
    />
    <link rel="canonical" href={canon} />
    <meta property="og:locale" content="en_BD" />
    <meta property="og:title" content={full} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canon} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={full} />
    {defaultOg && <meta property="og:image:width" content="1200" />}
    {defaultOg && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={full} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#b3122e" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} Product Feed`} href={siteUrl("/feed.xml")} />
    <script type="application/ld+json" set:html={JSON.stringify(org).replace(/</g, "\\u003c")} />
    <script type="application/ld+json" set:html={JSON.stringify(webSiteLd).replace(/</g, "\\u003c")} />
    <slot name="head" />
    <script is:inline src="/app.js" defer></script>
  </head>
  <body>
    <a class="skip" href="#main">
      Skip to content
    </a>
    <div class="notice" data-notice hidden role="status"></div>
    <div class="ticker">
      <div>
        <span>Wholesale prices on home appliances</span>
        <span>Cash on delivery across Bangladesh</span>
        <span>bKash, Nagad and Rocket accepted</span>
        <span>Call {SITE.phone}</span>
      </div>
    </div>
    <header class="top">
      <div class="wrap bar">
        <a href="/" class="logo" aria-label={`${SITE.name} home`}>
          <img class="logo-mark" src={SITE.logo || "/favicon.svg"} alt="" width="40" height="40" />
          <span class="logo-txt">
            <span class="logo-name">{logoStart}<em>{logoEnd}</em></span>
            <small class="logo-sub">Kitchen &amp; Home</small>
          </span>
        </a>
        <form action="/search/" class="find" role="search">
          <input
            name="q"
            type="search"
            placeholder="Search rice cooker, chair, wardrobe…"
            aria-label="Search products"
            autocomplete="off"
            data-suggest
          />
          <button aria-label="Search">
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.4"
              stroke-linecap="round"
              aria-hidden="true"
            >
              <circle cx="11" cy="11" r="7" />
              <path d="m20 20-4-4" />
            </svg>
          </button>
          <div class="suggest" data-suggestions hidden></div>
        </form>
        <nav class="icons" aria-label="Your shopping">
          <a href="/wishlist/">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 20s-7.5-4.6-9.2-9A5 5 0 0 1 12 7a5 5 0 0 1 9.2 4c-1.7 4.4-9.2 9-9.2 9Z" />
            </svg>
            <i data-wish-count hidden></i>
            <span>Wishlist</span>
          </a>
          <a href="/my-account/">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="8" r="4" />
              <path d="M4 21c1-4.5 4-6.5 8-6.500s7 2 8 6.5" />
            </svg>
            <span>Account</span>
          </a>
          <a href="/cart/">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M3 4h2.500l2.2 11h10.100l2-8H6.4" />
              <circle cx="9.5" cy="19.5" r="1.5" />
              <circle cx="17" cy="19.5" r="1.5" />
            </svg>
            <i data-cart-count hidden></i>
            <span>Cart</span>
          </a>
        </nav>
      </div>
      <div class="wrap nav">
        <a href="/shop/">Shop all</a>
        {MENU.map((g: any) => (
          <details class="mega">
            <summary>{g.title}</summary>
            <div>
              {g.items.map((c: any) => (
                <a href={catUrl(c)}>{c.name}</a>
              ))}
            </div>
          </details>
        ))}
        <a href="/offers/">Offers</a>
        <a href="/product-category/latest-product/">New</a>
        <a href="/product-category/popular-item/">Popular</a>
        <a href="/blog/">Blog</a>
        <a href="/track/">Track order</a>
        <a href="/contact-us/">Contact</a>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer>
      <div class="wrap cols">
        <div>
          <a href="/" class="logo" aria-label={`${SITE.name} home`}>
            <img class="logo-mark" src={SITE.logo || "/favicon.svg"} alt="" width="38" height="38" />
            <span class="logo-txt">
              <span class="logo-name">{logoStart}<em>{logoEnd}</em></span>
              <small class="logo-sub">Kitchen &amp; Home</small>
            </span>
          </a>
          <p>{SITE.about}</p>
          {SITE.address && <p>{SITE.address}</p>}
          {(SITE.facebook || SITE.youtube) && (
            <div class="social">
              {SITE.facebook && (
                <a class="fb" href={SITE.facebook} rel="noopener" target="_blank" aria-label={`${SITE.name} on Facebook`} title="Facebook">
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M13.5 21v-7.5h2.5l.4-3h-2.9V8.6c0-.9.3-1.500 1.500-1.500h1.500V4.400c-.3 0-1.200-.1-2.200-.1-2.200 0-3.700 1.300-3.700 3.800v2.400H8v3h2.500V21h3Z" />
                  </svg>
                </a>
              )}
              {SITE.youtube && (
                <a class="yt" href={SITE.youtube} rel="noopener" target="_blank" aria-label={`${SITE.name} on YouTube`} title="YouTube">
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M21.600 7.200a2.500 2.500 0 0 0-1.800-1.800C18.200 5 12 5 12 5s-6.200 0-7.800.4A2.500 2.500 0 0 0 2.400 7.200 26 26 0 0 0 2 12a26 26 0 0 0 .4 4.800 2.500 2.500 0 0 0 1.800 1.800C5.800 19 12 19 12 19s6.200 0 7.800-.4a2.500 2.500 0 0 0 1.800-1.800A26 26 0 0 0 22 12a26 26 0 0 0-.4-4.800ZM10 15V9l5.200 3L10 15Z" />
                  </svg>
                </a>
              )}
            </div>
          )}
        </div>
        <div>
          <h4>Company</h4>
          <a href="/about-us/">About us</a>
          <a href="/how-to-buy/">How to buy</a>
          <a href="/contact-us/">Contact us</a>
          <a href="/blog/">Blog</a>
          {extraPages.map((p: any) => (
            <a href={`/${p.slug}/`}>{p.title}</a>
          ))}
        </div>
        <div>
          <h4>Policies</h4>
          <a href="/privacy-policy/">Privacy policy</a>
          <a href="/terms-conditions/">Terms and conditions</a>
          <a href="/track/">Track your order</a>
        </div>
        <div>
          <h4>Payment</h4>
          <p data-payments>
            {payments.map((p: any) => (
              <>
                {p.label}
                {p.number && `: ${p.number}`}
                <br />
              </>
            ))}
          </p>
        </div>
      </div>
      <p class="legal">
        © {new Date().getFullYear()} {SITE.name}
      </p>
    </footer>
    <div class="floats">
      {SITE.whatsapp && (
        <a class="float wa" href={waOf(SITE.whatsapp)} rel="noopener" aria-label="Chat on WhatsApp">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4 20l1.300-3.900A8 8 0 1 1 8 18.800L4 20Z" />
          </svg>
        </a>
      )}
      <a class="float call" href={`tel:${telOf(SITE.phone)}`} aria-label="Call us">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M6.6 10.800a15 15 0 0 0 6.6 6.600l2.2-2.200a1 1 0 0 1 1-.25 11 11 0 0 0 3.6.6 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.500a1 1 0 0 1 1 1 11 11 0 0 0 .6 3.6 1 1 0 0 1-.25 1Z" />
        </svg>
      </a>
    </div>
    <div class="toast" role="status" data-toast></div>
  </body>
</html>
