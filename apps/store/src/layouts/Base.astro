---
import "../styles/fonts.css";
import "../styles/site.css";
import { jsonLd, organizationReturnPolicy, postalAddress, publicImage, storeAreaServed } from "../lib/seo";
import "../styles/mobile.css";
import { MENU, SITE, LIVE, pages, catUrl, telOf, waOf, siteUrl, languageOf, spacedSiteName } from "../lib/shop";
const { title, seoTitle, description = SITE.description, image, noindex, canonical, socialTitle, socialDescription, type = "website", preconnectCloudinary = false, language = languageOf(`${title || ""} ${description}`) } = Astro.props;
const full = seoTitle || (title ? `${title} | ${spacedSiteName}` : `${spacedSiteName} | ${SITE.tagline}`);
const canon = canonical || siteUrl(Astro.url.pathname);
const isHome = Astro.url.pathname === "/";
const preview = import.meta.env.BUILD_ENV !== "production";
const bingVerification = String(import.meta.env.BING_SITE_VERIFICATION || "").trim();
const googleVerification = String(import.meta.env.GOOGLE_SITE_VERIFICATION || "").trim();
if (bingVerification && !/^[A-Fa-f0-9]{16,64}$/.test(bingVerification)) {
  throw new Error("Invalid BING_SITE_VERIFICATION");
}
if (googleVerification && !/^[A-Za-z0-9_-]{16,128}$/.test(googleVerification)) {
  throw new Error("Invalid GOOGLE_SITE_VERIFICATION");
}
const parts = SITE.name.split(/(?=[A-Z])/);
const logoEnd = parts.length > 1 ? parts.pop() : "";
const logoStart = parts.join("");
const logoMark = !SITE.logo || SITE.logo === "/logo/primary-logo.jpg" ? "/logo/primary-logo-80.webp" : SITE.logo;
const absUrl = (u: string) => (u.startsWith("http") ? u : siteUrl(u));
const ogImage = publicImage(image) || siteUrl("/og-image.jpg");
const payments = LIVE.payments.filter((p: any) => p.enabled);
const alternateName = spacedSiteName !== SITE.name ? spacedSiteName : undefined;
const storeID = siteUrl("/#store");
const org = {
  "@context": "https://schema.org",
  "@type": "Store",
  "@id": storeID,
  name: SITE.name,
  alternateName,
  url: siteUrl("/"),
  description: SITE.description,
  logo: absUrl(SITE.logo || "/logo/primary-logo.jpg"),
  image: siteUrl("/og-image.jpg"),
  telephone: telOf(SITE.phone),
  email: SITE.email,
  currenciesAccepted: "BDT",
  paymentAccepted: payments.map((p: any) => p.label).join(", ") || undefined,
  hasMerchantReturnPolicy: organizationReturnPolicy,
  address: postalAddress(SITE.address),
  areaServed: storeAreaServed(SITE.address, LIVE),
  openingHours: SITE.hours || undefined,
  knowsLanguage: ["en-BD", "bn-BD"],
  sameAs: [SITE.facebook, SITE.youtube].filter(Boolean),
};
const webSiteLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": siteUrl("/#website"),
  name: spacedSiteName,
  alternateName: alternateName ? SITE.name : undefined,
  url: siteUrl("/"),
  inLanguage: ["en-BD", "bn-BD"],
  publisher: { "@id": storeID },
};
const standardSlugs = new Set(["about-us", "how-to-buy", "contact-us", "privacy-policy", "terms-conditions"]);
const extraPages = pages.filter((p: any) => !p.draft && !standardSlugs.has(p.slug));
---

<!doctype html>
<html lang={language} data-phone={SITE.phone}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    {preconnectCloudinary && (
      <>
        <link rel="preconnect" href="https://res.cloudinary.com" crossorigin />
        <link rel="dns-prefetch" href="https://res.cloudinary.com" />
      </>
    )}
    <title>{full}</title>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={preview ? "noindex, nofollow" : noindex ? "noindex, follow"
        : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"}
    />
    <link rel="canonical" href={canon} />
    <meta property="og:locale" content={language.replace("-", "_")} />
    <meta property="og:title" content={socialTitle || full} />
    <meta property="og:description" content={socialDescription || description} />
    <meta property="og:site_name" content={spacedSiteName} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canon} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={full} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={full} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#b3122e" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {isHome && !preview && bingVerification && <meta name="msvalidate.01" content={bingVerification} />}
    {isHome && !preview && googleVerification && <meta name="google-site-verification" content={googleVerification} />}
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} Product Feed`} href={siteUrl("/feed.xml")} />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} Blog`} href={siteUrl("/blog/feed.xml")} />
    {isHome && (
      <>
        <script type="application/ld+json" set:html={jsonLd(org)} />
        <script type="application/ld+json" set:html={jsonLd(webSiteLd)} />
      </>
    )}
    <slot name="head" />
    <script is:inline src="/app.js" defer fetchpriority="low"></script>
  </head>
  <body>
    <a class="skip" href="#main" lang="en-BD">
      Skip to content
    </a>
    <div class="notice" data-notice hidden role="status"></div>
    <div class="ticker" lang="en-BD">
      <div>
        <span>Wholesale prices on home appliances</span>
        <span>Delivery charge shown before you order</span>
        <span data-payment-summary>{payments.map((p: any) => p.label).join(" · ") || "Contact the shop for payment options"}</span>
        <span>Call {SITE.phone}</span>
      </div>
    </div>
    <header class="top" lang="en-BD">
      <div class="wrap bar">
        <a href="/" class="logo">
          <img class="logo-mark" src={logoMark} alt="" width="40" height="40" />
          <span class="logo-txt">
            <span class="logo-name">{logoStart}<em>{logoEnd}</em></span>
            <small class="logo-sub">Kitchen &amp; Home</small>
          </span>
        </a>
        <form action="/search/" class="find" role="search">
          <input
            name="q"
            type="search"
            placeholder="Search rice cooker, chair, wardrobe…"
            aria-label="Search products"
            autocomplete="off"
            data-suggest role="combobox" aria-autocomplete="list" aria-controls="search-suggestions" aria-expanded="false"
          />
          <button aria-label="Search">
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.4"
              stroke-linecap="round"
              aria-hidden="true"
            >
              <circle cx="11" cy="11" r="7" />
              <path d="m20 20-4-4" />
            </svg>
          </button>
          <div class="suggest" id="search-suggestions" data-suggestions role="listbox" aria-label="Suggested products" hidden></div>
        </form>
        <nav class="icons" aria-label="Your shopping">
          <a class="desktop-shopping-link" href="/wishlist/">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 20s-7.5-4.6-9.2-9A5 5 0 0 1 12 7a5 5 0 0 1 9.2 4c-1.7 4.4-9.2 9-9.2 9Z" />
            </svg>
            <i data-wish-count hidden></i>
            <span>Wishlist</span>
          </a>
          <a href="/my-account/">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="8" r="4" />
              <path d="M4 21c1-4.5 4-6.5 8-6.500s7 2 8 6.5" />
            </svg>
            <span>Account</span>
          </a>
          <a class="desktop-shopping-link" href="/cart/">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M3 4h2.500l2.2 11h10.100l2-8H6.4" />
              <circle cx="9.5" cy="19.5" r="1.5" />
              <circle cx="17" cy="19.5" r="1.5" />
            </svg>
            <i data-cart-count hidden></i>
            <span>Cart</span>
          </a>
        </nav>
      </div>
      <nav class="wrap nav" aria-label="Product categories and pages">
        <button type="button" class="category-toggle" data-categories aria-controls="category-drawer" aria-expanded="false">Categories ▾</button>
        <a class="desktop-shopping-link" href="/shop/">Shop all</a>
        {MENU.map((g: any) => (
          <details class="mega">
            <summary>{g.title}</summary>
            <div>
              {g.items.map((c: any) => (
                <a href={catUrl(c)} lang={languageOf(c.name)}>{c.name}</a>
              ))}
            </div>
          </details>
        ))}
        <a href="/offers/">Offers</a>
        <a href="/product-category/latest-product/">New</a>
        <a href="/product-category/popular-item/">Popular</a>
        <a href="/blog/">Blog</a>
        <a class="desktop-shopping-link" href="/track/">Track order</a>
        <a href="/contact-us/">Contact</a>
      </nav>
    </header>
    <dialog lang="en-BD" class="category-drawer" id="category-drawer" aria-labelledby="category-title">
      <div class="drawer-head"><h2 id="category-title">Shop by category</h2><button type="button" class="btn ghost" data-close-categories>Close</button></div>
      <a class="btn" href="/shop/">Browse all products</a>
      <div class="drawer-help">
        <a class="btn ghost" href={`tel:${telOf(SITE.phone)}`}>Call the shop</a>
        {SITE.whatsapp && <a class="btn ghost" href={waOf(SITE.whatsapp)} rel="noopener">WhatsApp</a>}
        <a class="link" href="/contact-us/">Contact us</a>
      </div>
      {MENU.map((group: any)=><section><h3>{group.title}</h3><div class="drawer-links">{group.items.map((c: any)=><a href={catUrl(c)} lang={languageOf(c.name)}>{c.name}<span aria-hidden="true">→</span></a>)}</div></section>)}
    </dialog>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer lang="en-BD">
      <div class="wrap cols">
        <div>
          <a href="/" class="logo">
            <img class="logo-mark" src={logoMark} alt="" width="38" height="38" />
            <span class="logo-txt">
              <span class="logo-name">{logoStart}<em>{logoEnd}</em></span>
              <small class="logo-sub">Kitchen &amp; Home</small>
            </span>
          </a>
          <p>{SITE.about}</p>
          {SITE.address && <p>{SITE.address}</p>}
          {(SITE.facebook || SITE.youtube) && (
            <div class="social">
              {SITE.facebook && (
                <a class="fb" href={SITE.facebook} rel="noopener" target="_blank" aria-label={`${SITE.name} on Facebook`} title="Facebook">
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M13.5 21v-7.5h2.5l.4-3h-2.9V8.6c0-.9.3-1.500 1.500-1.500h1.500V4.400c-.3 0-1.200-.1-2.200-.1-2.200 0-3.700 1.300-3.700 3.800v2.400H8v3h2.500V21h3Z" />
                  </svg>
                </a>
              )}
              {SITE.youtube && (
                <a class="yt" href={SITE.youtube} rel="noopener" target="_blank" aria-label={`${SITE.name} on YouTube`} title="YouTube">
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M21.600 7.200a2.500 2.500 0 0 0-1.800-1.800C18.200 5 12 5 12 5s-6.200 0-7.800.4A2.500 2.500 0 0 0 2.400 7.200 26 26 0 0 0 2 12a26 26 0 0 0 .4 4.800 2.500 2.500 0 0 0 1.800 1.800C5.800 19 12 19 12 19s6.200 0 7.800-.4a2.500 2.500 0 0 0 1.800-1.800A26 26 0 0 0 22 12a26 26 0 0 0-.4-4.800ZM10 15V9l5.200 3L10 15Z" />
                  </svg>
                </a>
              )}
            </div>
          )}
        </div>
        <div>
          <h4>Company</h4>
          <a href="/about-us/">About us</a>
          <a href="/how-to-buy/">How to buy</a>
          <a href="/contact-us/">Contact us</a>
          <a href="/blog/">Blog</a>
          <a href="/online-shopping-jashore/">Online shopping in Jashore</a>
          {["/", "/about-us/", "/about-us"].includes(Astro.url.pathname) && (
            <a class="community-link" href="https://www.hasnahenafoundation.com/about">Hasnahena Foundation in Jashore</a>
          )}
          {extraPages.map((p: any) => (
            <a href={`/${p.slug}/`}>{p.title}</a>
          ))}
        </div>
        <div>
          <h4>Policies</h4>
          <a href="/privacy-policy/">Privacy policy</a>
          <a href="/terms-conditions/">Terms and conditions</a>
          <a class="desktop-shopping-link" href="/track/">Track your order</a>
        </div>
        <div>
          <h4>Payment</h4>
          <p data-payments>
            {payments.map((p: any) => (
              <>
                {p.label}
                {p.number && `: ${p.number}`}
                <br />
              </>
            ))}
          </p>
        </div>
      </div>
      <p class="legal">
        © {new Date().getFullYear()} {SITE.name}
      </p>
    </footer>
    <div class="floats">
      {SITE.whatsapp && (
        <a class="float wa" href={waOf(SITE.whatsapp)} rel="noopener" aria-label="Chat on WhatsApp">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4 20l1.300-3.900A8 8 0 1 1 8 18.800L4 20Z" />
          </svg>
        </a>
      )}
      <a class="float call" href={`tel:${telOf(SITE.phone)}`} aria-label="Call us">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M6.6 10.800a15 15 0 0 0 6.6 6.600l2.2-2.200a1 1 0 0 1 1-.25 11 11 0 0 0 3.6.6 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.500a1 1 0 0 1 1 1 11 11 0 0 0 .6 3.6 1 1 0 0 1-.25 1Z" />
        </svg>
      </a>
    </div>
    <nav lang="en-BD" class="mobile-nav" aria-label="Quick shopping links">
      <a href="/shop/"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg><span>Shop</span></a>
      <a href="/wishlist/"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20S3 15 3 9a5 5 0 0 1 9-3 5 5 0 0 1 9 3c0 6-9 11-9 11Z"/></svg><span>Wishlist</span><i data-wish-count hidden></i></a>
      <a href="/track/"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 3 9 5v9l-9 5-9-5V8l9-5Zm0 10v9M3 8l9 5 9-5M7.5 5.5l9 5v5"/></svg><span>Track order</span></a>
      <a href="/cart/"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 3h2l3 12h11l2-9H6"/><circle cx="9" cy="20" r="1"/><circle cx="18" cy="20" r="1"/></svg><span>Cart</span><i data-cart-count hidden></i></a>
    </nav>
    <div class="toast" role="status" aria-live="polite" data-toast></div>
  </body>
</html>
