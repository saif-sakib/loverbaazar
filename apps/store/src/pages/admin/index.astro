---
import "@fontsource-variable/plus-jakarta-sans";
import "../../styles/site.css";
---
<!doctype html><html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" /><meta name="robots" content="noindex" /><title>LoverBaazar Admin</title></head>
<body><div class="wrap"><h1 style="margin-top:20px">LoverBaazar Admin</h1><p class="err" id="err"></p>
<form class="panel" id="login"><label class="field">Admin token<input id="tok" type="password" required /></label><button class="btn small">Enter</button></form>
<div id="app" hidden><div class="tabs"><button class="btn" data-t="orders">Orders</button><button class="btn" data-t="products">Products</button><button class="btn" data-t="messages">Messages</button><button class="btn ghost" id="pub">Publish storefront</button></div><p class="note" id="ok" hidden></p><div id="view" style="overflow-x:auto"></div></div></div>
<script is:inline>
const $=s=>document.querySelector(s),esc=s=>String(s??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));let T=sessionStorage.getItem("t")||"",P=[];
const api=async(p,o={})=>{const r=await fetch("/api/admin"+p,{...o,headers:{"X-Admin-Token":T,...(o.headers||{})}});const j=await r.json().catch(()=>({}));if(!r.ok)throw Error(j.error||"Request failed");return j};
const done=m=>{$("#ok").textContent=m;$("#ok").hidden=false};const run=f=>async(...a)=>{$("#err").textContent="";try{await f(...a)}catch(e){$("#err").textContent=e.message;if(/token/.test(e.message)){sessionStorage.removeItem("t");T="";$("#err").textContent="Wrong admin token. Please try again.";$("#login").hidden=false;$("#app").hidden=true}}};
const S=["pending","confirmed","shipped","delivered","cancelled"];
const orders=run(async()=>{const l=await api("/orders");const sum=l.filter(o=>o.status!="cancelled").reduce((a,o)=>a+o.total,0),open=l.filter(o=>o.status=="pending").length;$("#view").innerHTML=`<p><b>${l.length}</b> recent orders · <b>${open}</b> pending · <b>৳${sum}</b> total sales</p><table class="tbl"><tr><th>Order</th><th>Customer</th><th>Items</th><th>Total</th><th>Payment</th><th>Status</th><th></th></tr>${l.map(o=>`<tr><td>${esc(o.number)}<br><small>${esc(o.created_at.slice(0,16).replace("T"," "))}</small></td><td>${esc(o.name)}<br>${esc(o.phone)}<br>${esc(o.address)} (${esc(o.area)})<br><i>${esc(o.note)}</i></td><td>${(o.items||[]).map(i=>esc(i.name)+" × "+i.qty).join("<br>")}</td><td>৳${o.total}</td><td>${esc(o.payment)} ${esc(o.txn_id)}</td><td><select data-o="${esc(o.number)}">${S.map(s=>`<option ${s==o.status?"selected":""}>${s}</option>`).join("")}</select></td><td><button class="link" data-print="${esc(o.number)}">Invoice</button></td></tr>`).join("")}</table>`;
document.querySelectorAll("[data-o]").forEach(s=>s.onchange=run(async()=>{await api("/orders/"+s.dataset.o,{method:"PUT",body:JSON.stringify({status:s.value})});orders()}));
document.querySelectorAll("[data-print]").forEach(b=>b.onclick=()=>{const o=l.find(x=>x.number==b.dataset.print),w=window.open("");w.document.write(`<h2>LoverBaazar invoice ${esc(o.number)}</h2><p>${esc(o.name)}, ${esc(o.phone)}<br>${esc(o.address)}</p><table border=1 cellpadding=6>${(o.items||[]).map(i=>`<tr><td>${esc(i.name)}</td><td>${i.qty}</td><td>৳${i.price*i.qty}</td></tr>`).join("")}<tr><td colspan=2>Delivery</td><td>৳${o.shipping}</td></tr><tr><td colspan=2><b>Total</b></td><td><b>৳${o.total}</b></td></tr></table>`);w.print()})});
const products=run(async()=>{P=await api("/products");$("#view").innerHTML=`<button class="btn" id="new">Add product</button> <input id="f" placeholder="Filter" style="max-width:260px"><table class="tbl" style="margin-top:12px"><tbody id="rows"></tbody></table>`;const draw=()=>{const q=$("#f").value.toLowerCase();$("#rows").innerHTML=P.filter(p=>p.name.toLowerCase().includes(q)).map(p=>`<tr><td>${esc(p.name)}${p.active?"":" (hidden)"}</td><td>৳${p.price}</td><td>${p.stock} left</td><td><button class="link" data-e="${p.id}">Edit</button></td></tr>`).join("");document.querySelectorAll("[data-e]").forEach(b=>b.onclick=()=>edit(P.find(p=>p.id==b.dataset.e)))};$("#f").oninput=draw;$("#new").onclick=()=>edit({id:Date.now()%2147483647,cats:[],tags:[],images:[],attrs:[],active:true,isNew:true});draw()});
const edit=p=>{$("#view").innerHTML=`<form class="panel" id="pf">${[["name","Name"],["slug","URL slug"],["price","Price","number"],["regular","Regular price","number"],["stock","Stock","number"],["short","Short description"]].map(([k,l,t])=>`<label class="field">${l}<input name="${k}" type="${t||"text"}" value="${esc(p[k]??"")}" ${k!="short"?"required":""}></label>`).join("")}<label class="field">Category slugs (comma separated)<input name="cats" value="${esc((p.cats||[]).join(","))}"></label><label class="field">Image URLs (one per line)<textarea name="imgs" rows="3">${esc((p.images||[]).map(i=>i.src).join("\n"))}</textarea></label><label class="field">Upload image<input type="file" id="up" accept="image/*"></label><label class="field">Description (HTML)<textarea name="desc" rows="6">${esc(p.desc||"")}</textarea></label><label><input type="checkbox" name="active" style="width:auto" ${p.active?"checked":""}> Visible in shop</label><br><br><button class="btn">Save</button> <button type="button" class="btn ghost" id="back">Back</button></form>`;$("#back").onclick=products;
$("#up").onchange=run(async e=>{const r=await api("/image",{method:"POST",body:e.target.files[0]});const t=document.forms.pf.imgs;t.value=(t.value+"\n"+r.url).trim()});
$("#pf").onsubmit=run(async e=>{e.preventDefault();const d=Object.fromEntries(new FormData(e.target)),out={...p,name:d.name,slug:d.slug,price:+d.price,regular:+d.regular,stock:+d.stock,short:d.short,desc:d.desc,active:!!d.active,cats:d.cats.split(",").map(s=>s.trim()).filter(Boolean),images:d.imgs.split("\n").map(s=>s.trim()).filter(Boolean).map(src=>({...(p.images||[]).find(i=>i.src==src)||{src,thumb:src,alt:""}}))};delete out.isNew;delete out.imgs;await api("/products/"+p.id,{method:"PUT",body:JSON.stringify(out)});await products();done("Saved. Price and stock are live now. Click Publish storefront for names, photos and new products.")})};
const messages=run(async()=>{const l=await api("/messages");$("#view").innerHTML=l.map(m=>`<div class="panel" style="margin-bottom:8px"><b>${esc(m.name)}</b> ${esc(m.contact)}<p>${esc(m.body)}</p></div>`).join("")||"<p>No messages.</p>"});
const views={orders,products,messages};document.querySelectorAll("[data-t]").forEach(b=>b.onclick=()=>views[b.dataset.t]());
$("#pub").onclick=run(async()=>{done("Publishing…");const r=await api("/publish",{method:"POST"});done(r.message)});
const enter=()=>{$("#login").hidden=true;$("#app").hidden=false;orders()};$("#login").onsubmit=e=>{e.preventDefault();T=$("#tok").value;sessionStorage.setItem("t",T);enter()};if(T)enter();
</script></body></html>
