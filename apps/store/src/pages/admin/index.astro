---
import "@fontsource-variable/plus-jakarta-sans";
import "../../styles/site.css";
import "../../styles/admin.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>LoverBaazar Admin</title>
    <link rel="icon" href="data:," />
    <script is:inline src="/admin.js" defer></script>
  </head>
  <body class="admin">
    <div class="wrap">
      <form class="panel login" id="login">
        <h1>LoverBaazar Admin</h1>
        <label class="field">
          Admin password
          <input id="tok" type="password" autocomplete="current-password" required />
        </label>
        <label class="check field">
          <input id="keep" type="checkbox" /> Keep me signed in on this device
        </label>
        <p class="err" id="loginErr"></p>
        <button class="btn small">Enter</button>
      </form>
      <div id="app" hidden>
        <aside class="adminbar">
          <a class="adminlogo" href="#dashboard">LoverBaazar</a>
          <div class="adminfind">
            <input id="find" type="search" placeholder="Find anything…" aria-label="Search the admin" autocomplete="off" />
            <div id="findres" hidden></div>
          </div>
          <nav id="tabs"></nav>
          <div class="adminactions">
            <a class="link" href="/" target="_blank" rel="noopener">View the shop</a>
            <button class="link" id="pub2">Publish now</button>
            <button class="link" id="out">Log out</button>
          </div>
        </aside>
        <main class="adminmain">
          <div class="dirtybar" id="dirtybar" hidden>
            <span>You have changes that customers can't see yet.</span>
            <button class="btn" id="pub">Publish changes</button>
          </div>
          <div id="head"></div>
          <p class="note" id="ok" hidden role="status"></p>
          <p class="err" id="err" role="alert"></p>
          <div id="view"></div>
        </main>
      </div>
    </div>
  </body>
</html>
