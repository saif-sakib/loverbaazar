---
import "../../styles/fonts.css";
import "../../styles/site.css";
import "../../styles/admin.css";
import "../../styles/mobile.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <meta name="robots" content="noindex" />
    <title>LoverBaazar Admin</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline src="/admin.js" defer></script>
  </head>
  <body class="admin">
    <div class="wrap">
      <form class="panel login" id="login">
        <div class="login-badge">
          <img class="adminlogo-mark" src="/favicon.svg" alt="" width="40" height="40" />
          <div class="login-brand-txt">
            <b>Lover<em>Baazar</em></b>
            <span>Admin Console</span>
          </div>
        </div>
        <h1>Sign in to Admin</h1>
        <p class="login-sub">Enter your admin password to manage orders, catalog, and storefront settings.</p>
        <label class="field">
          <span class="flabel">Admin password</span>
          <input id="tok" type="password" autocomplete="current-password" required />
        </label>
        <label class="check field">
          <input id="keep" type="checkbox" /> Keep me signed in on this device
        </label>
        <p class="err" id="loginErr" role="alert" tabindex="-1"></p>
        <button class="btn login-btn">Sign in</button>
      </form>
      <div id="app" hidden>
        <aside class="adminbar">
          <div class="adminbar-top">
            <a class="adminlogo" href="#dashboard">
              <img class="adminlogo-mark" src="/favicon.svg" alt="" width="34" height="34" />
              <span class="adminlogo-txt"><b>LoverBaazar</b><span>Admin</span></span>
            </a>
            <a class="shop-ext" href="/" target="_blank" rel="noopener">View shop ↗</a>
          </div>
          <div class="adminfind">
            <input id="find" type="search" placeholder="Find anything…" aria-label="Search the admin" autocomplete="off" />
            <div id="findres" hidden></div>
          </div>
          <label class="mobile-section">Go to
            <select id="admin-section" aria-label="Admin section"></select>
          </label>
          <nav id="tabs" aria-label="Shop management"></nav>
          <div class="adminactions">
            <button class="link" id="pub2">Publish now</button>
            <button class="link" id="out">Log out</button>
          </div>
        </aside>
        <main class="adminmain">
          <div class="dirtybar" id="dirtybar" hidden>
            <span><b>Website changes ready</b><br />Publish your saved edits to make them visible to customers.</span>
            <button class="btn" id="pub">Publish changes</button>
          </div>
          <div id="head"></div>
          <p class="note" id="ok" hidden role="status"></p>
          <p class="err" id="err" role="alert" tabindex="-1"></p>
          <div id="view"></div>
        </main>
      </div>
    </div>
    <dialog class="order-invoice" id="order-invoice" aria-labelledby="invoice-title">
      <form method="dialog" class="invoice-controls">
        <button type="button" class="btn" data-print-invoice>Print / Save PDF</button>
        <button class="btn ghost" autofocus>Close</button>
      </form>
      <article id="invoice-preview"></article>
    </dialog>
  </body>
</html>
