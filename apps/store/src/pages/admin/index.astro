---
import "@fontsource-variable/plus-jakarta-sans";
import "../../styles/site.css";
import "../../styles/admin.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>LoverBaazar Admin</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline src="/admin.js" defer></script>
  </head>
  <body class="admin">
    <div class="wrap">
      <form class="panel login" id="login">
        <div class="login-badge"><img class="adminlogo-mark" src="/favicon.svg" alt="" width="24" height="24" />LoverBaazar · Admin</div>
        <h1>Sign in to Admin</h1>
        <p class="login-sub">Enter your admin password to manage orders, catalog, and storefront settings.</p>
        <label class="field">
          <span class="flabel">Admin password</span>
          <input id="tok" type="password" autocomplete="current-password" required />
        </label>
        <label class="check field">
          <input id="keep" type="checkbox" /> Keep me signed in on this device
        </label>
        <p class="err" id="loginErr"></p>
        <button class="btn login-btn">Sign in</button>
      </form>
      <div id="app" hidden>
        <aside class="adminbar">
          <div class="adminbar-top">
            <a class="adminlogo" href="#dashboard"><img class="adminlogo-mark" src="/favicon.svg" alt="" width="24" height="24" />LoverBaazar <span>Admin</span></a>
            <a class="shop-ext" href="/" target="_blank" rel="noopener">View shop ↗</a>
          </div>
          <div class="adminfind">
            <input id="find" type="search" placeholder="Find anything…" aria-label="Search the admin" autocomplete="off" />
            <div id="findres" hidden></div>
          </div>
          <nav id="tabs"></nav>
          <div class="adminactions">
            <button class="link" id="pub2">Publish now</button>
            <button class="link" id="out">Log out</button>
          </div>
        </aside>
        <main class="adminmain">
          <div class="dirtybar" id="dirtybar" hidden>
            <span>You have saved changes that need <b>Publish</b> before customers can see them.</span>
            <button class="btn" id="pub">Publish changes</button>
          </div>
          <div id="head"></div>
          <p class="note" id="ok" hidden role="status"></p>
          <p class="err" id="err" role="alert"></p>
          <div id="view"></div>
        </main>
      </div>
    </div>
  </body>
</html>
