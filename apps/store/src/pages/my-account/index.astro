---
import Base from "../../layouts/Base.astro";
---
<Base title="My account" noindex><div class="wrap"><h1 style="margin-top:20px">My account</h1><div data-account></div><div class="two" data-auth hidden style="grid-template-columns:1fr 1fr">
<form class="panel" data-form="login"><h3>Log in</h3><label class="field">Mobile number<input name="phone" required /></label><label class="field">Password<input name="password" type="password" required autocomplete="current-password" /></label><p class="err"></p><button class="btn small">Log in</button></form>
<form class="panel" data-form="register"><h3>Sign up</h3><label class="field">Name<input name="name" required /></label><label class="field">Mobile number<input name="phone" required /></label><label class="field">Password (8+ characters)<input name="password" type="password" minlength="8" required autocomplete="new-password" /></label><p class="err"></p><p class="meta">By signing up you accept the <a href="/terms-conditions/">terms</a> and <a href="/privacy-policy/">privacy policy</a>.</p><button class="btn small">Create account</button></form></div></div></Base>
