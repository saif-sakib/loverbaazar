---
import Base from "../../layouts/Base.astro";
import { SITE, say } from "../../lib/shop";
---

<Base title={say("accountHeading")} noindex>
  <div class="wrap">
    <h1 class="title">{say("accountHeading")}</h1>
    <div data-account></div>
    <div class="two even" data-auth hidden>
      <form class="panel" data-form="login">
        <h3>Log in</h3>
        <label class="field">
          Mobile number
          <input name="phone" required inputmode="tel" autocomplete="tel" />
        </label>
        <label class="field">
          Password
          <input name="password" type="password" required autocomplete="current-password" />
        </label>
        <p class="err"></p>
        <button class="btn small">Log in</button>
        <p class="meta">Forgot your password? Call {SITE.phone} and we'll set a new one.</p>
      </form>
      <form class="panel" data-form="register">
        <h3>Sign up</h3>
        <label class="field">
          Name
          <input name="name" required autocomplete="name" />
        </label>
        <label class="field">
          Mobile number
          <input name="phone" required inputmode="tel" autocomplete="tel" />
        </label>
        <label class="field">
          Password (8+ characters)
          <input name="password" type="password" minlength="8" maxlength="72" required autocomplete="new-password" />
        </label>
        <p class="err"></p>
        <p class="meta">
          By signing up you accept the{" "}
          <a class="link" href="/terms-conditions/">
            terms
          </a>{" "}
          and{" "}
          <a class="link" href="/privacy-policy/">
            privacy policy
          </a>
          .
        </p>
        <button class="btn small">Create account</button>
      </form>
    </div>
  </div>
</Base>
