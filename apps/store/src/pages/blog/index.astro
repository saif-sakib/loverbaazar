---
import Base from "../../layouts/Base.astro";
import AdSlot from "../../components/AdSlot.astro";
import { posts, spacedSiteName } from "../../lib/shop";
const when = (d: string) => new Date(d).toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" });
---

<Base title="Home Appliance Buying & Price Guides in Bangladesh" description={`Buying guides, price comparisons, and appliance tips in Bangladesh from ${spacedSiteName}.`} allowAds>
  <div class="wrap">
    <div class="pagehead">
      <h1 class="title">Blog</h1>
    </div>
    <section class="posts">
      {posts.map((p) => (
        <a href={`/${p.slug}/`}>
          <small>{when(p.date)}</small>
          <b>{p.title}</b>
          <span>{p.excerpt}</span>
        </a>
      ))}
    </section>
    <AdSlot />
  </div>
</Base>
