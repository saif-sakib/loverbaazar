---
import Base from "../../layouts/Base.astro";
import { posts, say } from "../../lib/shop";
const when = (d: string) => new Date(d).toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" });
---

<Base title={say("blogHeading")}>
  <div class="wrap">
    <div class="pagehead">
      <h1 class="title">{say("blogHeading")}</h1>
    </div>
    <section class="posts">
      {posts.map((p) => (
        <a href={`/${p.slug}/`}>
          <small>{when(p.date)}</small>
          <b>{p.title}</b>
          <span>{p.excerpt}</span>
        </a>
      ))}
    </section>
  </div>
</Base>
