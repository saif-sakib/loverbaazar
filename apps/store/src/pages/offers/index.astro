---
import Base from "../../layouts/Base.astro";
import Grid from "../../components/Grid.astro";
import { onSale } from "../../lib/shop";
const items = onSale();
---

<Base title="Home Appliance & Furniture Offers in Bangladesh" description="Browse discounted home appliances, cookware and furniture in Bangladesh at Lover Baazar with live BDT prices and cash on delivery.">
  <div class="wrap">
    <div class="pagehead">
      <h1 class="title">Offers</h1>
    </div>
    {items.length ? <Grid items={items} /> : <p>No offers right now. <a class="link" href="/shop/">See everything we sell</a>.</p>}
  </div>
</Base>
