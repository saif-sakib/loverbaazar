---
import Base from "../../layouts/Base.astro";
import Grid from "../../components/Grid.astro";
import { deliveryZonesText, jsonLd, priceBounds } from "../../lib/seo";
import { activeOffers, LIVE, offersEnabled, SITE, siteUrl, spacedSiteName, taka } from "../../lib/shop";
const items = activeOffers();
const heading = String(SITE.offers?.title || "").trim() || "Offers";
const intro = String(SITE.offers?.intro || "").trim();
const hasOffers = offersEnabled() && items.length > 0;
const bounds = priceBounds(items);
const deliverySummary = deliveryZonesText(LIVE);
const offersTitle = heading === "Offers" ? "Home Appliance & Furniture Offers in Bangladesh" : heading;
const offersDesc = hasOffers && bounds.min > 0
  ? `Save on ${items.length} discounted home appliances, cookware and furniture from ${taka(bounds.min)} to ${taka(bounds.max)} at ${spacedSiteName}. ${deliverySummary}.`
  : `Browse discounted home appliances, cookware and furniture at ${spacedSiteName}. ${deliverySummary}.`;
const crumbs = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: siteUrl("/") },
    { "@type": "ListItem", position: 2, name: "Shop", item: siteUrl("/shop/") },
    { "@type": "ListItem", position: 3, name: heading },
  ],
};
const collection = hasOffers
  ? {
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      name: offersTitle,
      description: offersDesc,
      url: siteUrl("/offers/"),
      mainEntity: {
        "@type": "ItemList",
        numberOfItems: items.length,
        itemListElement: items.slice(0, 24).map((p: any, i: number) => ({
          "@type": "ListItem",
          position: i + 1,
          url: siteUrl(`/product/${p.slug}/`),
          name: p.name,
        })),
      },
    }
  : null;
---

<Base title={offersTitle} description={offersDesc} noindex={!hasOffers} preconnectCloudinary>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={jsonLd(crumbs)} />
    {collection && <script type="application/ld+json" set:html={jsonLd(collection)} />}
  </Fragment>
  <div class="wrap">
    <div class="pagehead">
      <h1 class="title">{heading}</h1>
      {hasOffers && intro && <p class="cat-summary">{intro}</p>}
      {hasOffers && bounds.min > 0 && (
        <p class="cat-summary">
          <strong>{items.length}</strong> discounted {items.length === 1 ? "product" : "products"} · Offer prices {bounds.max > bounds.min ? `${taka(bounds.min)} – ${taka(bounds.max)}` : taka(bounds.min)} ·{" "}
          {deliverySummary}
        </p>
      )}
    </div>
    {hasOffers ? <Grid items={items} /> : <p>No offers right now. <a class="link" href="/shop/">See everything we sell</a>.</p>}
  </div>
</Base>
