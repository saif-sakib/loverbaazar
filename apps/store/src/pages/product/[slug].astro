---
import Base from "../../layouts/Base.astro";
import { categoryChain, deliveryZonesText, gtinOf, jsonLd, merchantReturnPolicy, merchantReturnURL, plainText, primaryCategoryOf, productSeoTitle, publicImage, recordSEO, skuOf } from "../../lib/seo";
import { gallerySizes, responsiveImage, sizedImage } from "../../lib/image-delivery.mjs";
import Card from "../../components/Card.astro";
import AdSlot from "../../components/AdSlot.astro";
import { products, cats, taka, off, catUrl, SITE, LIVE, telOf, waOf, rating, fileSlug, siteUrl, attributeValues, languageOf, spacedSiteName } from "../../lib/shop";
export const getStaticPaths = () => products.map((p) => ({ params: { slug: fileSlug(p.slug) }, props: { p } }));
const { p } = Astro.props;
const d = off(p);
const url = siteUrl(`/product/${p.slug}/`);
const myCats = p.cats.map((s: string) => cats.find((c: any) => c.slug === s)).filter(Boolean);
const primaryCat = primaryCategoryOf(p.cats, cats);
const catTrail = primaryCat ? categoryChain(primaryCat, cats) : [];
const nonMerchSlugs = new Set(myCats.filter((c: any) => c.slug !== "latest-product" && c.slug !== "popular-item").map((c: any) => c.slug));
const primaryPool = primaryCat ? products.filter((x) => x.id !== p.id && x.cats.includes(primaryCat.slug)) : [];
const secondaryPool = products.filter(
  (x) => x.id !== p.id && !primaryPool.some((y) => y.id === x.id) &&
    (nonMerchSlugs.size ? x.cats.some((c: string) => nonMerchSlugs.has(c)) : x.cats.some((c: string) => p.cats.includes(c))),
);
const fallbackPool = products.filter(
  (x) => x.id !== p.id && !primaryPool.some((y) => y.id === x.id) && !secondaryPool.some((y) => y.id === x.id) &&
    x.cats.some((c: string) => p.cats.includes(c)),
);
const related = [...primaryPool, ...secondaryPool, ...fallbackPool].slice(0, 4);
const stars = rating(p);
const localOnlyNote = "Delivery available only in Jashore.";
// Suppress the imported shop-wide boilerplate while preserving product-specific notes.
const short = String(p.short ?? "")
  .replace(/^Cash on delivery available\. Delivery time 4-7 days\. Free delivery in Jashore\.\s*/, "")
  .replace(/Delivery time 4-7 days\. (?=Delivery available only in Jashore\.)/, "");
const localDeliveryOnly = short.includes(localOnlyNote);
const productSummary = short.replace(localOnlyNote, "").trim();
const snippetText = plainText(productSummary || p.desc);
const deliverySummary = localDeliveryOnly ? "Delivery in Jashore only" : deliveryZonesText(LIVE);
const description = `${p.name} price in Bangladesh is ${taka(p.price)} at ${spacedSiteName}. ${p.inStock ? "In stock" : "Currently sold out"}. ${deliverySummary}.${snippetText ? ` ${snippetText}` : ""}`;
const seo = recordSEO(p, description);
const brandName = attributeValues(p, "brand")[0];
const gtin = gtinOf(p);
const mainImage = p.images[0];
const displayImage = (image: any) => responsiveImage(image?.src, image?.src || image?.thumb, [320, 640]);
const imageSet = displayImage(mainImage);
const thumbnail = (image: any) => responsiveImage(image.src, image.thumb || image.src, [160]).src;
const ld = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: p.name,
  url: seo.canonical || url,
  category: primaryCat?.name || undefined,
  sku: skuOf(p),
  brand: brandName ? { "@type": "Brand", name: brandName } : undefined,
  gtin,
  mpn: p.mpn || undefined,
  image: p.images.map((i: any) => publicImage(i.src)).filter(Boolean),
  description: snippetText || p.name,
  offers: {
    "@type": "Offer",
    url: seo.canonical || url,
    priceCurrency: "BDT",
    price: p.price,
    availability: p.inStock ? "https://schema.org/InStock" : "https://schema.org/OutOfStock",
    itemCondition: p.condition === "new" ? "https://schema.org/NewCondition" : undefined,
    seller: { "@type": "Store", "@id": siteUrl("/#store"), name: SITE.name },
    priceSpecification: p.regular > p.price
      ? { "@type": "UnitPriceSpecification", priceType: "https://schema.org/StrikethroughPrice", price: p.regular, priceCurrency: "BDT" }
      : undefined,
    hasMerchantReturnPolicy: merchantReturnPolicy,
  },
  aggregateRating: p.reviews.length
    ? { "@type": "AggregateRating", ratingValue: stars.toFixed(1), reviewCount: p.reviews.length }
    : undefined,
  review: p.reviews.length
    ? p.reviews.slice(0, 5).map((r: any) => ({
        "@type": "Review",
        author: { "@type": "Person", name: r.name },
        reviewRating: { "@type": "Rating", ratingValue: r.rating },
        reviewBody: r.body,
      }))
    : undefined,
};
const crumbs = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: siteUrl("/") },
    ...catTrail.map((entry: any, i: number) => ({
      "@type": "ListItem",
      position: 2 + i,
      name: entry.name,
      item: siteUrl(catUrl(entry)),
    })),
    { "@type": "ListItem", position: 2 + catTrail.length, name: p.name },
  ],
};
const waText = encodeURIComponent(`Hi, I have a question about ${p.name}.\n${url}`);
---

<Base
  title={productSeoTitle(p.name)}
  {...seo}
  image={seo.image || publicImage(mainImage?.src)}
  type="product"
  preconnectCloudinary
  allowAds
>
  <Fragment slot="head">
    {mainImage?.src && (
      <link
        rel="preload"
        as="image"
        href={imageSet.srcset ? undefined : imageSet.src}
        imagesrcset={imageSet.srcset}
        imagesizes={imageSet.srcset ? gallerySizes : undefined}
        fetchpriority="high"
      />
    )}
    <meta property="product:price:amount" content={String(p.price)} />
    <meta property="product:price:currency" content="BDT" />
    <meta property="product:availability" content={p.inStock ? "in stock" : "out of stock"} />
    <script type="application/ld+json" set:html={jsonLd(ld)} />
    <script type="application/ld+json" set:html={jsonLd(crumbs)} />
  </Fragment>
  <div class="wrap">
    <p class="crumbs">
      <a href="/">Home</a> /{" "}
      {catTrail.map((entry: any) => (
        <>
          <a href={catUrl(entry)}>{entry.name}</a> /{" "}
        </>
      ))}
      {p.name}
    </p>
    <section class="pd" data-product={p.id} data-price={p.price}>
      <div class="product-intro">
        <h1 lang={languageOf(p.name)}>{p.name}</h1>
        {p.reviews.length > 0 && (
          <p class="meta">
            <a href="#reviews">
              <span class="stars" aria-hidden="true">{"★".repeat(Math.round(stars))}</span> {stars.toFixed(1)} out of 5 ({p.reviews.length}{" "}
              {p.reviews.length === 1 ? "review" : "reviews"})
            </a>
          </p>
        )}
        <div class="price" data-price-for={p.id}>
          <b>{taka(p.price)}</b>
          {p.regular > p.price && <s>{taka(p.regular)}</s>}
        </div>
        <div class="product-availability">
          <p class={p.inStock ? "stock" : "stock no"} data-stock-for={p.id}>{p.inStock ? "In stock" : "Sold out"}</p>
          <p class="meta" data-save-for={p.id} hidden={d === 0}>You save {d}%</p>
        </div>
      </div>
      <div class="product-gallery">
        <div class="stage">
          <img class="main" data-main {...imageSet} sizes={imageSet.srcset ? gallerySizes : undefined}
            data-zoom={sizedImage(mainImage?.src, 960)} alt={mainImage?.alt || p.name} width="600" height="600" decoding="sync" fetchpriority="high" />
        </div>
        {p.images.length > 1 && (
          <div class="gal">
            {p.images.map((i: any, n: number) => (
              <button class={n === 0 ? "on" : undefined} data-thumb={displayImage(i).src} data-srcset={displayImage(i).srcset} data-zoom={sizedImage(i.src, 960)}
                data-alt={i.alt || p.name} aria-label={`View image ${n + 1}`} aria-pressed={n === 0}>
                <img src={thumbnail(i)} alt="" loading="lazy" width="66" height="66" />
              </button>
            ))}
          </div>
        )}
      </div>
      <div class="product-details">
        <div class="buy">
          <input class="qty" data-qty type="number" min="1" max="20" value="1" aria-label="Quantity" />
          <button class="btn" data-add={p.id} data-label="Add to cart" disabled={!p.inStock}>
            {p.inStock ? "Add to cart" : "Sold out"}
          </button>
          <button class="btn ghost" data-add={p.id} data-label="Buy now" data-buy="1" disabled={!p.inStock}>
            {p.inStock ? "Buy now" : "Sold out"}
          </button>
          <button class="btn ghost" data-wish={p.id}>
            ♥ Wishlist
          </button>
        </div>
        <section class="purchase-info" aria-labelledby="purchase-info-title">
          <h2 id="purchase-info-title">Delivery &amp; payment</h2>
          {localDeliveryOnly ? (
            <p class="delivery local-delivery"><strong>{localOnlyNote}</strong> <a class="link" href="/contact-us/">Ask the shop about delivery</a>.</p>
          ) : <ul class="delivery" data-delivery>
            {LIVE.delivery.map((z: any) => (
              <li>{z.label}: <b>{z.fee && !(LIVE.freeOver > 0 && p.price >= LIVE.freeOver) ? taka(z.fee) : "Free"}</b>{z.days && `, ${z.days}`}</li>
            ))}
          </ul>}
          <p class="meta" data-payment-summary>{LIVE.payments.filter((m: any) => m.enabled).map((m: any) => m.label).join(" · ") || "Contact the shop for payment options"}</p>
          <div class="purchase-links">
            <a class="link" href="/how-to-buy/">How to order</a>
            {merchantReturnURL && <a class="link" href={merchantReturnURL}>Returns and exchanges</a>}
          </div>
          {SITE.returns && <p class="meta">{SITE.returns}</p>}
        </section>
        {(SITE.phone || SITE.whatsapp) && <div class="product-help">
          <b>Questions about this product?</b>
          <div class="purchase-links">
            {SITE.phone && <a class="link" href={`tel:${telOf(SITE.phone)}`}>Call {SITE.phone}</a>}
            {SITE.whatsapp && <a class="link" href={`${waOf(SITE.whatsapp)}?text=${waText}`} rel="noopener">Ask on WhatsApp</a>}
          </div>
        </div>}
        {productSummary && <p lang={languageOf(productSummary)}>{productSummary}</p>}
        {p.attrs.length > 0 && <section class="specifications" aria-labelledby="specifications-title"><h2 id="specifications-title">Specifications</h2><dl>{p.attrs.map((a: any)=><div><dt>{a.name}</dt><dd>{a.values.join(", ")}</dd></div>)}</dl></section>}
        {p.sku && <p class="meta">SKU: {p.sku}</p>}
        <p class="meta">
          {myCats.map((c: any, i: number) => (
            <>
              {i > 0 && ", "}
              <a href={catUrl(c)}>{c.name}</a>
            </>
          ))}
        </p>
      </div>
    </section>
    {p.desc ? (
      <section class="prose">
        <h2>Description</h2>
        <Fragment set:html={p.desc} />
      </section>
    ) : !productSummary && (
      <section class="prose">
        <h2>Product overview</h2>
        <p>
          <strong>{p.name}</strong> is priced at <strong>{taka(p.price)}</strong> in Bangladesh at {spacedSiteName}
          {brandName ? ` (${brandName})` : ""} and is currently {p.inStock ? "in stock" : "out of stock"}.
          {primaryCat && (
            <>
              {" "}Compare more options in <a href={catUrl(primaryCat)}>{primaryCat.name}</a>.
            </>
          )}
        </p>
        <p>
          Available payments: {LIVE.payments.filter((m: any) => m.enabled).map((m: any) => m.label).join(", ") || "contact the shop"}. See{" "}
          <a href="/how-to-buy/">delivery and buying details</a>.
        </p>
      </section>
    )}
    <section class="prose" id="reviews">
      <h2>Customer reviews</h2>
      {p.reviews.length === 0 && <p>No reviews yet. Be the first to share your experience.</p>}
      {p.reviews.map((r: any) => (
        <div class="review">
          <b>{r.name}</b>{" "}
          <span class="stars" aria-label={`${r.rating} out of 5`}>
            {"★".repeat(r.rating)}
          </span>
          <p>{r.body}</p>
        </div>
      ))}
      <details class="add-review">
        <summary class="btn ghost">Write a review</summary>
        <form data-review={p.id}>
          <label class="field">
            Your name
            <input name="name" required maxlength="60" autocomplete="name" />
          </label>
          <label class="field">
            Rating
            <select name="rating">
              <option value="5">★★★★★ Excellent</option>
              <option value="4">★★★★ Good</option>
              <option value="3">★★★ Average</option>
              <option value="2">★★ Poor</option>
              <option value="1">★ Very poor</option>
            </select>
          </label>
          <label class="field">
            Your review<textarea name="body" rows="3" required minlength="5" maxlength="1000"></textarea>
          </label>
          <input class="trap" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <p class="err" role="alert" tabindex="-1"></p>
          <button class="btn">Send review</button>
        </form>
      </details>
    </section>
    {related.length > 0 && (
      <>
        <div class="sec">
          <h2>You may also like</h2>
          {primaryCat && <a href={catUrl(primaryCat)}>All {primaryCat.name} prices</a>}
        </div>
        <section class="grid">
          {related.map((x) => (
            <Card p={x} />
          ))}
        </section>
      </>
    )}
    <AdSlot kind="catalog" />
    <section data-recent-wrap hidden>
      <div class="sec">
        <h2>Recently viewed</h2>
      </div>
      <div class="grid" data-recent></div>
    </section>
  </div>
  <div class="buybar" data-buybar>
    <div class="price" data-price-for={p.id}>
      <b>{taka(p.price)}</b>
    </div>
    <button class="btn" data-add={p.id} data-label="Add to cart" disabled={!p.inStock}>
      {p.inStock ? "Add to cart" : "Sold out"}
    </button>
  </div>
</Base>
