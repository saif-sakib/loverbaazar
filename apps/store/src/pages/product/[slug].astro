---
import Base from "../../layouts/Base.astro"; import Card from "../../components/Card.astro";
import { products, cats, img, taka, off, catUrl, SHOP } from "../../lib/shop";
export const getStaticPaths = () => products.map((p) => ({ params: { slug: p.slug }, props: { p } }));
const { p } = Astro.props; const d = off(p);
const myCats = p.cats.map((s) => cats.find((c) => c.slug === s)).filter(Boolean);
const related = products.filter((x) => x.id !== p.id && x.cats.some((c) => p.cats.includes(c))).slice(0, 4);
const ld = { "@context":"https://schema.org","@type":"Product",name:p.name,sku:p.sku||undefined,image:p.images.map((i)=>img(i.src)),description:p.short||p.name,offers:{"@type":"Offer",url:`https://loverbaazar.com/product/${p.slug}/`,priceCurrency:"BDT",price:p.price,availability:p.inStock?"https://schema.org/InStock":"https://schema.org/OutOfStock"}};
---
<Base title={p.name} description={p.short || `Buy ${p.name} online in Bangladesh from LoverBaazar.`} image={img(p.images[0]?.src)}>
<script slot="head" type="application/ld+json" set:html={JSON.stringify(ld).replace(/</g,"\\u003c")} />
<div class="wrap"><p class="crumbs"><a href="/">Home</a> / {myCats[0] && <><a href={catUrl(myCats[0])}>{myCats[0].name}</a> / </>}{p.name}</p>
<section class="pd"><div><img class="main" data-main src={img(p.images[0]?.src)} alt={p.images[0]?.alt || p.name} width="600" height="600" />
{p.images.length > 1 && <div class="gal">{p.images.map((i) => <button data-thumb={img(i.src)} aria-label="View image"><img src={img(i.thumb)} alt="" loading="lazy" /></button>)}</div>}</div>
<div><h1>{p.name}</h1><div class="price" data-price-for={p.id}><b>{taka(p.price)}</b>{p.regular > p.price && <s>{taka(p.regular)}</s>}</div>{d > 0 && <p class="meta">You save {d}%</p>}
<p class={p.inStock ? "stock" : "stock no"}>{p.inStock ? "In stock" : "Sold out"}</p>{p.short && <p>{p.short}</p>}
<div class="buy"><input class="qty" data-qty type="number" min="1" max="20" value="1" aria-label="Quantity" /><button class="btn" data-add={p.id} disabled={!p.inStock}>Add to cart</button><button class="btn ghost" data-add={p.id} data-go="1" disabled={!p.inStock}>Buy now</button><button class="btn ghost" data-wish={p.id}>♥ Wishlist</button></div>
{p.attrs.map((a) => <p class="meta"><b>{a.name}:</b> {a.values.join(", ")}</p>)}
{p.sku && <p class="meta">SKU: {p.sku}</p>}<p class="meta">{myCats.map((c, i) => <>{i > 0 && ", "}<a href={catUrl(c)}>{c.name}</a></>)}</p>
<p class="note">Order by phone: <a href={`tel:${SHOP.tel}`}><b>{SHOP.phone}</b></a></p></div></section>
{p.desc && <section class="prose"><h2>Description</h2><Fragment set:html={p.desc} /></section>}
{related.length > 0 && <><div class="sec"><h2>You may also like</h2></div><section class="grid">{related.map((x) => <Card p={x} />)}</section></>}
</div></Base>
