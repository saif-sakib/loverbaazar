---
import Base from "../layouts/Base.astro";
import Card from "../components/Card.astro";
import { products, inCat, MENU, catUrl, img, SITE, cats } from "../lib/shop";
const withPhoto = (l: any[]) => l.filter((p) => p.images[0]);
const heroPics = withPhoto(SITE.home.flatMap((h: any) => inCat(h.cat)))
  .filter((p: any, i: number, all: any[]) => all.findIndex((x) => x.id === p.id) === i)
  .filter((_: any, i: number) => i % 7 === 0)
  .slice(0, 3);
const tiles = MENU.flatMap((g: any) => g.items)
  .filter((c: any) => inCat(c.slug).length)
  .slice(0, 12);
const hero = SITE.hero;
const heroWords = hero.title.trim().split(" ");
const heroEnd = heroWords.pop();
---

<Base type="website">
  <div class="wrap">
    <section class="hero">
      <div>
        <p class="eyebrow">{SITE.tagline}</p>
        <h1>{heroWords.join(" ")} <em>{heroEnd}</em></h1>
        <p>{hero.text}</p>
        {hero.button && (
          <a class="btn" href={hero.link || "/shop/"}>
            {hero.button.replace("{count}", products.length)}
          </a>
        )}
      </div>
      <div class="pics">
        {heroPics.map((p: any, i: number) => (
          <a href={`/product/${p.slug}/`}>
            <img src={img(i === 0 ? p.images[0]?.src : p.images[0]?.thumb)} alt={p.name} width="600" height="600" />
          </a>
        ))}
      </div>
    </section>
    {SITE.banners.length > 0 && (
      <section class="banners">
        {SITE.banners.map((b: any) => (
          <a href={b.link || "/shop/"}>
            <img src={b.image} alt={b.title || ""} loading="lazy" />
          </a>
        ))}
      </section>
    )}
    <section class="perks">
      {SITE.perks.map((k: any) => (
        <div>
          <b>{k.title}</b>
          <span>{k.text}</span>
        </div>
      ))}
    </section>
    {tiles.length > 0 && (
      <>
        <div class="sec">
          <h2>Shop by category</h2>
          <a href="/shop/">View all</a>
        </div>
        <section class="cats">
          {tiles.map((c: any) => (
            <a href={catUrl(c)}>
              <img src={img(inCat(c.slug)[0].images[0]?.thumb)} alt="" loading="lazy" width="150" height="150" />
              {c.name}
              <small>{inCat(c.slug).length} items</small>
            </a>
          ))}
        </section>
      </>
    )}
    {SITE.home.map(
      (h: any) =>
        inCat(h.cat).length > 0 && (
          <>
            <div class="sec">
              <h2>{h.title}</h2>
              <a href={catUrl(cats.find((c: any) => c.slug === h.cat) || { path: h.cat })}>See all</a>
            </div>
            <section class="grid">
              {inCat(h.cat)
                .slice(0, 8)
                .map((p: any) => (
                  <Card p={p} />
                ))}
            </section>
          </>
        ),
    )}
    <section data-recent-wrap hidden>
      <div class="sec">
        <h2>Recently viewed</h2>
      </div>
      <div class="grid" data-recent></div>
    </section>
  </div>
</Base>
