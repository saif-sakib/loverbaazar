---
import Base from "../layouts/Base.astro";
import { responsiveImage, sizedImage } from "../lib/image-delivery.mjs";
import { freeLocalArea, hasNationwideDelivery, isMerchandisingCategory, merchantReturnURL, priceBounds, summary } from "../lib/seo";
import Card from "../components/Card.astro";
import { products, inCat, homeItems, MENU, catUrl, languageOf, SITE, cats, LIVE, spacedSiteName, taka, telOf } from "../lib/shop";
const sections = SITE.home.map((section: any) => ({
  ...section,
  items: homeItems(section.cat).sort((a, b) => Number(b.inStock) - Number(a.inStock)),
})).filter((section: any) => section.items.length);
const featured = [...sections.flatMap((section: any) => section.items), ...products]
  .find((p) => p.inStock && p.images[0]?.src);
const featurePhoto = featured && responsiveImage(featured.images[0].src, featured.images[0].src, [160, 320, 640]);
const menuTiles = MENU.flatMap((g: any) => g.items);
const extraTiles = cats.filter((c: any) => !isMerchandisingCategory(c.slug));
const homeCategories = sections.map((section: any) => extraTiles.find((c: any) => c.slug === section.cat)).filter(Boolean);
const tiles = [...new Map([...homeCategories, ...menuTiles, ...extraTiles].map((c: any) => [c.slug, c])).values()]
  .filter((c: any) => !isMerchandisingCategory(c.slug))
  .map((c: any) => {
    const items = inCat(c.slug);
    const image = (items.find((p) => p.inStock && p.images[0]) || items.find((p) => p.images[0]))?.images[0];
    return { ...c, count: items.length, minPrice: priceBounds(items).min, thumb: sizedImage(image?.src || image?.thumb, 160) };
  })
  .filter((c) => c.count);
const quickCategories = tiles.slice(0, 6);
const moreCategories = tiles.slice(6);
const hero = SITE.hero;
const brandWords = spacedSiteName.trim().split(/\s+/);
const brandEnd = brandWords.pop();
const nationwide = hasNationwideDelivery(LIVE);
const homeDescription = summary(`${spacedSiteName}. ${SITE.description}${nationwide ? " Delivery across Bangladesh." : ""}`);
const payments = LIVE.payments.filter((p: any) => p.enabled);
const freeArea = freeLocalArea(LIVE);
---

<Base seoTitle={`${spacedSiteName} | ${SITE.tagline}`} description={homeDescription} preconnectCloudinary>
  <div class="wrap">
    <section class:list={["home-hero", { "has-featured-product": featured }]}>
      <div>
        <h1 lang={languageOf(spacedSiteName)}>{brandWords.join(" ")} <em>{brandEnd}</em></h1>
        {hero.title && <p class="hero-title" lang={languageOf(hero.title)}>{hero.title}</p>}
        {hero.text && <p class="hero-description" lang={languageOf(hero.text)}>{hero.text}</p>}
        <div class="hero-actions">
          <a class="btn" href={hero.link || "/shop/"}>{(hero.button || "Shop all products").replace("{count}", String(products.length))}</a>
          <a class="hero-offers" href="/offers/">See offers <span aria-hidden="true">→</span></a>
        </div>
      </div>
      {featured && <a class="hero-feature" href={`/product/${featured.slug}/`}>
        <img {...featurePhoto} sizes={featurePhoto?.srcset ? "(min-width: 1200px) 250px, (min-width: 861px) 21vw, 104px" : undefined}
          alt="" width="280" height="280" fetchpriority="high" />
        <span class="hero-feature-details">
          <strong lang={languageOf(featured.name)}>{featured.name}</strong>
          <span class="price" data-price-for={featured.id}>
            <b>{taka(featured.price)}</b>
            {featured.regular > featured.price && <s>{taka(featured.regular)}</s>}
          </span>
          <span class="hero-feature-link">View product <span aria-hidden="true">→</span></span>
        </span>
      </a>}
    </section>
    <nav class="shop-guide" aria-label="Shopping information">
      <a href="/how-to-buy/#delivery"><strong data-delivery-coverage>{nationwide ? "Delivery across Bangladesh" : "Delivery information"}</strong><span data-delivery-feature>{freeArea ? `Free delivery in ${freeArea.area}` : "See the cost before ordering"}</span></a>
      <a href="/how-to-buy/"><strong data-payment-feature>{(payments.find((p: any) => p.id === "cod") || payments[0])?.label || "Payment options"}</strong><span>Order without an account</span></a>
      <a href="/contact-us/"><strong>Contact the shop</strong><span>{SITE.phone ? `Call ${SITE.phone}` : "Send us a message"}</span></a>
      {merchantReturnURL && <a href={merchantReturnURL}><strong>Returns &amp; exchanges</strong><span>Check the shop’s policy</span></a>}
    </nav>
    {SITE.banners.length > 0 && (
      <section class="banners">
        {SITE.banners.map((b: any) => (
          <a href={b.link || "/shop/"}>
            <img src={b.image} alt={b.title || "Explore featured products"} loading="lazy" decoding="async" />
          </a>
        ))}
      </section>
    )}
    {quickCategories.length > 0 && (
      <>
        <div class="sec">
          <h2>Shop by category</h2>
          <a href="/shop/">Browse all</a>
        </div>
        <section class="cats">
          {quickCategories.map((c) => (
            <a href={catUrl(c)} lang={languageOf(c.name)}>
              <img src={c.thumb} alt="" loading="lazy" decoding="async" width="150" height="150" />
              {c.name}
              {c.minPrice > 0 && <small>From {taka(c.minPrice)}</small>}
            </a>
          ))}
        </section>
        {moreCategories.length > 0 && <details class="more-categories">
          <summary>More categories</summary>
          <nav class="cat-pills" aria-label="More product categories">
            {moreCategories.map((c) => <a href={catUrl(c)} lang={languageOf(c.name)}>{c.name}</a>)}
          </nav>
        </details>}
      </>
    )}
    {sections.map((h: any) => (
      <>
        <div class="sec">
          <h2>{h.title}</h2>
          <a href={h.cat === "on-sale" ? "/offers/" : catUrl(cats.find((c: any) => c.slug === h.cat) || { path: h.cat })}>All {h.title.toLowerCase()}</a>
        </div>
        <section class="grid">
          {h.items.slice(0, h.count || 8).map((p: any) => <Card p={p} />)}
        </section>
      </>
    ))}
    <section class="prose" aria-labelledby="shopping-help-title">
      <h2 id="shopping-help-title">Delivery and support</h2>
      <p>
        <a href="/how-to-buy/#delivery">Check delivery charges</a> or see our <a href="/online-shopping-jashore/">Jashore shopping guide</a> for local delivery.
      </p>
      <p>
        Questions before you order? {SITE.phone && <><a href={`tel:${telOf(SITE.phone)}`}>Call {SITE.phone}</a> or{" "}</>}
        <a href="/contact-us/">contact the shop</a>. Already ordered? <a href="/track/">Track your order</a>.
      </p>
    </section>
    <section data-recent-wrap hidden>
      <div class="sec">
        <h2>Recently viewed</h2>
      </div>
      <div class="grid" data-recent></div>
    </section>
  </div>
</Base>
