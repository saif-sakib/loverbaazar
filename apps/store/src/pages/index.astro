---
import Base from "../layouts/Base.astro";
import { responsiveImage, sizedImage } from "../lib/image-delivery.mjs";
import { freeLocalArea, isMerchandisingCategory, merchantReturnURL, priceBounds } from "../lib/seo";
import Card from "../components/Card.astro";
import AdSlot from "../components/AdSlot.astro";
import { products, inCat, homeItems, MENU, catUrl, languageOf, SITE, cats, LIVE, spacedSiteName, taka, telOf } from "../lib/shop";
const withPhoto = (l: any[]) => l.filter((p) => p.images[0]);
const heroPics = withPhoto(SITE.home.flatMap((h: any) => homeItems(h.cat)))
  .filter((p: any, i: number, all: any[]) => all.findIndex((x) => x.id === p.id) === i)
  .filter((_: any, i: number) => i % 7 === 0)
  .slice(0, 3);
const heroShots = heroPics.map((p: any, i: number) => ({
  href: `/product/${p.slug}/`,
  photo: responsiveImage(p.images[0]?.src, i === 0 ? p.images[0]?.src : p.images[0]?.thumb, i === 0 ? [320, 640] : [160, 320]),
  thumbnail: sizedImage(p.images[0]?.src, 160),
  name: p.name,
}));
const menuTiles = MENU.flatMap((g: any) => g.items);
const extraTiles = cats.filter((c: any) => !isMerchandisingCategory(c.slug));
const tiles = [...menuTiles, ...extraTiles]
  .filter((c: any, i: number, all: any[]) => inCat(c.slug).length && all.findIndex((x) => x.slug === c.slug) === i)
  .map((c: any) => {
    const items = inCat(c.slug);
    const image = items.find((p: any) => p.images[0])?.images[0];
    return { ...c, count: items.length, minPrice: priceBounds(items).min, thumb: sizedImage(image?.src || image?.thumb, 160) };
  });
const hero = SITE.hero;
const brandWords = spacedSiteName.trim().split(/\s+/);
const brandEnd = brandWords.pop();
const homeDescription = [spacedSiteName, SITE.address].filter(Boolean).join(" in ") + ". " + SITE.description;
const payments = LIVE.payments.filter((p: any) => p.enabled);
const freeArea = freeLocalArea(LIVE);
---

<Base seoTitle={`${spacedSiteName} | ${SITE.tagline}`} description={homeDescription} preconnectCloudinary allowAds>
  <div class="wrap">
    <section class="hero home-hero">
      <div>
        <p class="eyebrow">{SITE.tagline}</p>
        <h1 lang={languageOf(spacedSiteName)}>{brandWords.join(" ")} <em>{brandEnd}</em></h1>
        <p>
          <strong lang={languageOf(hero.title)}>{hero.title}</strong><br />
          <span lang={languageOf(hero.text)}>{hero.text}</span>
        </p>
        <div class="hero-actions">
          {hero.button && (
            <a class="btn" href={hero.link || "/shop/"}>
              {hero.button.replace("{count}", String(products.length))} <span aria-hidden="true">↗</span>
            </a>
          )}
          <a class="hero-offers" href="/offers/">Explore offers <span aria-hidden="true">→</span></a>
        </div>
      </div>
      {heroShots.length > 0 && <div class="pics">
        {heroShots.map((h: any, index: number) => (
          <a href={h.href}>
            <picture>
              <source media="(min-width: 861px)" srcset={h.photo.srcset || h.photo.src} sizes={index === 0 ? "33vw" : "16vw"} />
              <img src={index === 0 ? h.thumbnail : h.photo.src} alt="" width="600" height="600"
                loading={index === 0 ? "eager" : "lazy"} fetchpriority={index === 0 ? "high" : "auto"} />
            </picture>
            <span class="hero-product">{h.name} <span aria-hidden="true">↗</span></span>
          </a>
        ))}
      </div>}
    </section>
    <nav class="shop-guide" aria-label="Shopping information">
      <a href="/contact-us/"><strong>{SITE.address || "Contact the shop"}</strong><span>Call or message the shop</span></a>
      <a href="/how-to-buy/"><strong data-payment-feature>{(payments.find((p: any) => p.id === "cod") || payments[0])?.label || "Payment options"}</strong><span>Order without an account</span></a>
      <a href="/how-to-buy/#delivery"><strong data-delivery-feature>{freeArea ? `Free delivery in ${freeArea.area}` : "Delivery charges"}</strong><span>See the cost before ordering</span></a>
      {merchantReturnURL && <a href={merchantReturnURL}><strong>Returns &amp; exchanges</strong><span>Check the shop’s policy</span></a>}
    </nav>
    {SITE.banners.length > 0 && (
      <section class="banners">
        {SITE.banners.map((b: any) => (
          <a href={b.link || "/shop/"}>
            <img src={b.image} alt={b.title || "Explore featured products"} loading="lazy" decoding="async" />
          </a>
        ))}
      </section>
    )}
    {tiles.length > 0 && (
      <>
        <div class="sec">
          <h2>Shop by category</h2>
          <a href="/shop/">View all</a>
        </div>
        <section class="cats">
          {tiles.map((c: any) => (
            <a href={catUrl(c)}>
              <img src={c.thumb} alt="" loading="lazy" decoding="async" width="150" height="150" />
              {c.name}
              <small>{c.count} items{c.minPrice > 0 ? ` · From ${taka(c.minPrice)}` : ""}</small>
            </a>
          ))}
        </section>
      </>
    )}
    {SITE.home.map(
      (h: any) =>
        homeItems(h.cat).length > 0 && (
          <>
            <div class="sec">
              <h2>{h.title}</h2>
              <a href={h.cat === "on-sale" ? "/offers/" : catUrl(cats.find((c: any) => c.slug === h.cat) || { path: h.cat })}>All {h.title.toLowerCase()}</a>
            </div>
            <section class="grid">
              {homeItems(h.cat)
                .slice(0, h.count || 8)
                .map((p: any) => (
                  <Card p={p} />
                ))}
            </section>
          </>
        ),
    )}
    <section class="prose" aria-labelledby="jashore-shopping-title">
      <h2 id="jashore-shopping-title">Online shopping in Jashore (Jessore) for your home</h2>
      <p>
        {spacedSiteName} is a local online home appliance, cookware, and furniture store based in{" "}
        <strong>{SITE.address || "Jashore"}</strong>. Compare live BDT prices on rice cookers, pressure cookers,
        nonstick cookware, induction cookers, gas stoves, chairs, tables, wardrobes, and water filters from trusted
        brands like Kiam, RFL, and Akij.
      </p>
      <p>
        Questions before you order? {SITE.phone && <><a href={`tel:${telOf(SITE.phone)}`}>Call {SITE.phone}</a> or{" "}</>}
        <a href="/contact-us/">contact the shop</a>. Already ordered? <a href="/track/">Track your order</a>.
      </p>
    </section>
    <AdSlot kind="content" />
    <section data-recent-wrap hidden>
      <div class="sec">
        <h2>Recently viewed</h2>
      </div>
      <div class="grid" data-recent></div>
    </section>
  </div>
</Base>
