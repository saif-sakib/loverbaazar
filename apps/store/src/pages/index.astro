---
import Base from "../layouts/Base.astro";
import Card from "../components/Card.astro";
import { products, inCat, homeItems, MENU, catUrl, img, SITE, cats, fill, say } from "../lib/shop";
const withPhoto = (l: any[]) => l.filter((p) => p.images[0]);
const heroPics = withPhoto(SITE.home.flatMap((h: any) => homeItems(h.cat)))
  .filter((p: any, i: number, all: any[]) => all.findIndex((x) => x.id === p.id) === i)
  .filter((_: any, i: number) => i % 7 === 0)
  .slice(0, 3);
// The admin can choose these. With no choice made, the shop picks them itself.
const heroShots = SITE.heroImages?.length
  ? SITE.heroImages.slice(0, 3).map((h: any) => ({ href: h.link || "/shop/", src: h.image, alt: h.title || "" }))
  : heroPics.map((p: any, i: number) => ({
      href: `/product/${p.slug}/`,
      src: img(i === 0 ? p.images[0]?.src : p.images[0]?.thumb),
      alt: p.name,
    }));
const tiles = (SITE.catTiles?.length ? SITE.catTiles.map((s: string) => cats.find((c: any) => c.slug === s)).filter(Boolean) : MENU.flatMap((g: any) => g.items))
  .filter((c: any) => inCat(c.slug).length)
  .slice(0, 12);
const hero = SITE.hero;
const heroWords = hero.title.trim().split(" ");
const heroEnd = heroWords.pop();
---

<Base type="website">
  <div class="wrap">
    <section class="hero">
      <div>
        <p class="eyebrow">{SITE.tagline}</p>
        <h1>{heroWords.join(" ")} <em>{heroEnd}</em></h1>
        <p>{hero.text}</p>
        {hero.button && (
          <a class="btn" href={hero.link || "/shop/"}>
            {hero.button.replace("{count}", products.length)}
          </a>
        )}
      </div>
      <div class="pics">
        {heroShots.map((h: any) => (
          <a href={h.href}>
            <img src={h.src} alt={h.alt} width="600" height="600" />
          </a>
        ))}
      </div>
    </section>
    {SITE.banners.length > 0 && (
      <section class="banners">
        {SITE.banners.map((b: any) => (
          <a href={b.link || "/shop/"}>
            <img src={b.image} alt={b.title || ""} loading="lazy" />
          </a>
        ))}
      </section>
    )}
    {SITE.perks.length > 0 && (
      <section class="perks">
        {SITE.perks.map((k: any) => (
          <div>
            <b>{k.title}</b>
            <span>{fill(k.text)}</span>
          </div>
        ))}
      </section>
    )}
    {SITE.showCats !== false && tiles.length > 0 && (
      <>
        <div class="sec">
          <h2>{say("categoriesHeading")}</h2>
          <a href="/shop/">{say("viewAll")}</a>
        </div>
        <section class="cats">
          {tiles.map((c: any) => (
            <a href={catUrl(c)}>
              <img src={img(inCat(c.slug)[0].images[0]?.thumb)} alt="" loading="lazy" width="150" height="150" />
              {c.name}
              <small>{inCat(c.slug).length} items</small>
            </a>
          ))}
        </section>
      </>
    )}
    {SITE.home.map(
      (h: any) =>
        homeItems(h.cat).length > 0 && (
          <>
            <div class="sec">
              <h2>{h.title}</h2>
              <a href={h.cat === "on-sale" ? "/offers/" : catUrl(cats.find((c: any) => c.slug === h.cat) || { path: h.cat })}>{say("seeAll")}</a>
            </div>
            <section class="grid">
              {homeItems(h.cat)
                .slice(0, h.count || 8)
                .map((p: any) => (
                  <Card p={p} />
                ))}
            </section>
          </>
        ),
    )}
    <section data-recent-wrap hidden>
      <div class="sec">
        <h2>{say("recentlyViewed")}</h2>
      </div>
      <div class="grid" data-recent></div>
    </section>
  </div>
</Base>
