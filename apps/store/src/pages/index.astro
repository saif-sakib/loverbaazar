---
import Base from "../layouts/Base.astro";
import { responsiveImage } from "../lib/image-delivery.mjs";
import { isMerchandisingCategory, priceBounds } from "../lib/seo";
import Card from "../components/Card.astro";
import { products, inCat, homeItems, MENU, catUrl, img, languageOf, SITE, cats, LIVE, spacedSiteName, taka } from "../lib/shop";
const withPhoto = (l: any[]) => l.filter((p) => p.images[0]);
const heroPics = withPhoto(SITE.home.flatMap((h: any) => homeItems(h.cat)))
  .filter((p: any, i: number, all: any[]) => all.findIndex((x) => x.id === p.id) === i)
  .filter((_: any, i: number) => i % 7 === 0)
  .slice(0, 3);
const heroShots = heroPics.map((p: any, i: number) => ({
  href: `/product/${p.slug}/`,
  photo: responsiveImage(p.images[0]?.src, i === 0 ? p.images[0]?.src : p.images[0]?.thumb, i === 0 ? [320, 640] : [160, 320]),
  alt: p.name,
  name: p.name,
}));
const menuTiles = MENU.flatMap((g: any) => g.items);
const extraTiles = cats.filter((c: any) => !isMerchandisingCategory(c.slug));
const tiles = [...menuTiles, ...extraTiles]
  .filter((c: any, i: number, all: any[]) => inCat(c.slug).length && all.findIndex((x) => x.slug === c.slug) === i)
  .map((c: any) => {
    const items = inCat(c.slug);
    return { ...c, count: items.length, minPrice: priceBounds(items).min };
  });
const hero = SITE.hero;
const brandWords = spacedSiteName.trim().split(/\s+/);
const brandEnd = brandWords.pop();
const homeDescription = [spacedSiteName, SITE.address].filter(Boolean).join(" in ") + ". " + SITE.description;
---

<Base seoTitle={`${spacedSiteName} | ${SITE.tagline}`} description={homeDescription}>
  <div class="wrap">
    <section class="hero home-hero">
      <div>
        <p class="eyebrow">{SITE.tagline}</p>
        <h1 lang={languageOf(spacedSiteName)}>{brandWords.join(" ")} <em>{brandEnd}</em></h1>
        <p>
          <strong lang={languageOf(hero.title)}>{hero.title}</strong><br />
          <span lang={languageOf(hero.text)}>{hero.text}</span>
        </p>
        <div class="hero-actions">
          {hero.button && (
            <a class="btn" href={hero.link || "/shop/"}>
              {hero.button.replace("{count}", String(products.length))} <span aria-hidden="true">↗</span>
            </a>
          )}
          <a class="hero-offers" href="/offers/">Explore offers <span aria-hidden="true">→</span></a>
        </div>
      </div>
      <div class="pics">
        {heroShots.map((h: any, index: number) => (
          <a href={h.href}>
            <picture>
              <source media="(min-width: 861px)" srcset={h.photo.srcset || h.photo.src} sizes={index === 0 ? "33vw" : "16vw"} />
              <img src="/logo/primary-logo-80.webp" alt={h.alt} width="600" height="600"
                loading={index === 0 ? "eager" : "lazy"} fetchpriority={index === 0 ? "high" : "auto"} />
            </picture>
            <span class="hero-product">{h.name} <span aria-hidden="true">↗</span></span>
          </a>
        ))}
      </div>
    </section>
    {SITE.banners.length > 0 && (
      <section class="banners">
        {SITE.banners.map((b: any) => (
          <a href={b.link || "/shop/"}>
            <img src={b.image} alt={b.title || "Explore featured products"} loading="lazy" decoding="async" />
          </a>
        ))}
      </section>
    )}
    {tiles.length > 0 && (
      <>
        <div class="sec">
          <h2>Shop by category</h2>
          <a href="/shop/">View all</a>
        </div>
        <section class="cats">
          {tiles.map((c: any) => (
            <a href={catUrl(c)}>
              <img src={img(inCat(c.slug)[0].images[0]?.thumb)} alt="" loading="lazy" width="150" height="150" />
              {c.name}
              <small>{c.count} items{c.minPrice > 0 ? ` · From ${taka(c.minPrice)}` : ""}</small>
            </a>
          ))}
        </section>
      </>
    )}
    <section class="perks" aria-label="Shopping information">
      <div>
        <b data-payment-feature>{LIVE.payments.find((p: any)=>p.enabled)?.label || "Payment options"}</b>
        <span>See available methods at checkout</span>
      </div>
      <div>
        <b>Delivery</b>
        <span>Choose your area for the exact charge</span>
      </div>
      <div>
        <b>Wholesale prices</b>
        <span>Trusted brands</span>
      </div>
      <div>
        <b>Need help?</b>
        <span>Call {SITE.phone}</span>
      </div>
    </section>
    {SITE.home.map(
      (h: any) =>
        homeItems(h.cat).length > 0 && (
          <>
            <div class="sec">
              <h2>{h.title}</h2>
              <a href={h.cat === "on-sale" ? "/offers/" : catUrl(cats.find((c: any) => c.slug === h.cat) || { path: h.cat })}>All {h.title.toLowerCase()}</a>
            </div>
            <section class="grid">
              {homeItems(h.cat)
                .slice(0, h.count || 8)
                .map((p: any) => (
                  <Card p={p} />
                ))}
            </section>
          </>
        ),
    )}
    <section data-recent-wrap hidden>
      <div class="sec">
        <h2>Recently viewed</h2>
      </div>
      <div class="grid" data-recent></div>
    </section>
  </div>
</Base>
