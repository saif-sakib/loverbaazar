---
import { jsonLd, recordSEO, plainText } from "../../lib/seo";
import Base from "../../layouts/Base.astro";
import Grid from "../../components/Grid.astro";
import { cats, inCat, fileSlug, SITE, siteUrl } from "../../lib/shop";
export const getStaticPaths = () => cats.map((c) => ({ params: { path: fileSlug(c.path) }, props: { c } }));
const { c } = Astro.props;
const items = inCat(c.slug);
const seo = recordSEO(c, plainText(c.html) || `Browse ${c.name} at ${SITE.name}. See product details, prices and availability.`);
const crumbs = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: siteUrl("/") },
    { "@type": "ListItem", position: 2, name: "Shop", item: siteUrl("/shop/") },
    { "@type": "ListItem", position: 3, name: c.name },
  ],
};
---

<Base title={c.name} {...seo} noindex={seo.noindex || !items.length}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={jsonLd(crumbs)} />
  </Fragment>
  <div class="wrap">
    <p class="crumbs">
      <a href="/">Home</a> / <a href="/shop/">Shop</a> / {c.name}
    </p>
    <div class="pagehead">
      <h1>{c.name}</h1>
      {c.html && <div class="prose"><Fragment set:html={c.html} /></div>}
    </div>
    {items.length ? <Grid items={items} /> : <div class="empty"><p>No products here yet. See everything else we sell in the shop.</p><a class="btn" href="/shop/">Shop all</a></div>}
  </div>
</Base>
