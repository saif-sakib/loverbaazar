---
import Base from "../../layouts/Base.astro";
import Grid from "../../components/Grid.astro";
import { cats, inCat, fileSlug, SITE } from "../../lib/shop";
export const getStaticPaths = () => cats.map((c) => ({ params: { path: fileSlug(c.path) }, props: { c } }));
const { c } = Astro.props;
const items = inCat(c.slug);
---

<Base
  title={c.name}
  description={`${c.name} price in Bangladesh. Buy ${c.name} online from ${SITE.name} with cash on delivery.`}
  noindex={!items.length}
>
  <div class="wrap">
    <p class="crumbs">
      <a href="/">Home</a> / <a href="/shop/">Shop</a> / {c.name}
    </p>
    <div class="pagehead">
      <h1>{c.name}</h1>
    </div>
    {items.length ? <Grid items={items} /> : <div class="empty"><p>No products here yet. See everything else we sell in the shop.</p><a class="btn" href="/shop/">Shop all</a></div>}
  </div>
</Base>
