---
import Base from "../../layouts/Base.astro";
---

<Base title="Track your order" noindex>
  <div class="wrap narrow">
    <h1 class="title">Track your order</h1>
    <div class="mine" data-mine hidden>
      <p class="meta">Your recent orders on this device:</p>
      <div></div>
    </div>
    <form class="panel" data-track>
      <label class="field">
        Order number
        <input name="order" required placeholder="LB-XXXXXXXX" />
      </label>
      <label class="field">
        Mobile number
        <input name="phone" required />
      </label>
      <p class="err" data-err></p>
      <button class="btn small">Track</button>
    </form>
    <div data-order></div>
  </div>
</Base>
