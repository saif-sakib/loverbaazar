---
import { jsonLd, merchantReturnURL, recordSEO, summary as snippet, publicImage } from "../lib/seo";
import Base from "../layouts/Base.astro";
import AdSlot from "../components/AdSlot.astro";
import { pages, posts, fileSlug, fill, SITE, siteUrl, languageOf } from "../lib/shop";
export const getStaticPaths = () => [...pages, ...posts].filter(p => !p.draft).map((p) => ({ params: { slug: fileSlug(p.slug) }, props: { p } }));
const { p } = Astro.props;
const html = fill(p.html).replace(/href="tel:([^"]*)"/g, (_, n) => `href="tel:${n.replace(/[^\d+]/g, "")}"`);
const summary = snippet(p.excerpt || html) || p.title;
const date = p.date && new Date(p.date).toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric", timeZone: "Asia/Dhaka" });
const crumbs = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: siteUrl("/") },
    ...(p.date ? [{ "@type": "ListItem", position: 2, name: "Blog", item: siteUrl("/blog/") }] : []),
    { "@type": "ListItem", position: p.date ? 3 : 2, name: p.title },
  ],
};
const article = p.date
  ? {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      headline: p.title,
      description: summary,
      datePublished: p.date,
      dateModified: p.modified || undefined,
      image: publicImage(p.image),
      inLanguage: languageOf(p.title + " " + html),
      url: siteUrl(`/${p.slug}/`),
      author: { "@type": "Organization", name: SITE.name },
      publisher: { "@type": "Organization", name: SITE.name, logo: { "@type": "ImageObject", url: siteUrl(SITE.logo || "/logo/primary-logo.jpg") } },
    }
  : null;
const pageDescriptions: Record<string, string> = {
  "about-us": `Meet ${SITE.name}${SITE.address ? ` in ${SITE.address}` : ""}. Shop cookware, home appliances and furniture, and find out how to reach the shop.`,
  "how-to-buy": `See how to order from ${SITE.name} without an account, check delivery charges, choose a payment method and track your order. Instructions in Bangla and English.`,
};
const seo = recordSEO(p, pageDescriptions[p.slug] || summary);
---

<Base title={p.title} {...seo} image={seo.image || p.image} type={p.date ? "article" : "website"} allowAds={Boolean(p.date)}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={jsonLd(crumbs)} />
    {article && <script type="application/ld+json" set:html={jsonLd(article)} />}
  </Fragment>
  <div class="wrap narrow">
    <p class="crumbs">
      <a href="/">Home</a> / {p.date && <><a href="/blog/">Blog</a> / </>}
      {p.title}
    </p>
    <div class="pagehead">
      <h1 lang={languageOf(p.title)}>{p.title}</h1>
      {date && <p class="meta"><time datetime={p.date}>{date}</time></p>}
    </div>
    <article class="prose article">
      <Fragment set:html={html} />
      {p.slug === "how-to-buy" && (
        <section id="delivery" aria-labelledby="delivery-guide-title">
          <h2 id="delivery-guide-title">Delivery charges and order tracking</h2>
          <p>Check the product page for delivery area limits. At checkout, choose your area to see the delivery charge and order total. Where there’s a delivery fee, it’s charged per item.</p>
          <p>Keep your order number and use it with the mobile number you ordered with to <a href="/track/">track your order</a>. {merchantReturnURL && <><a href={merchantReturnURL}>Read the returns and exchanges policy</a>.</>}</p>
        </section>
      )}
      {p.slug === "about-us" && <p><a href="/contact-us/">See the shop’s address and contact details</a>.</p>}
    </article>
    {p.date && <AdSlot />}
  </div>
</Base>
