---
import Base from "../layouts/Base.astro";
import { pages, posts, fileSlug, fill, SITE, siteUrl } from "../lib/shop";
export const getStaticPaths = () => [...pages, ...posts].map((p) => ({ params: { slug: fileSlug(p.slug) }, props: { p } }));
const { p } = Astro.props;
const html = fill(p.html).replace(/href="tel:([^"]*)"/g, (_, n) => `href="tel:${n.replace(/[^\d+]/g, "")}"`);
const summary = p.excerpt || html.replace(/<[^>]+>/g, " ").replace(/\s+/g, " ").trim().slice(0, 155);
const date = p.date && new Date(p.date).toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" });
const crumbs = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: siteUrl("/") },
    ...(p.date ? [{ "@type": "ListItem", position: 2, name: "Blog", item: siteUrl("/blog/") }] : []),
    { "@type": "ListItem", position: p.date ? 3 : 2, name: p.title },
  ],
};
const article = p.date
  ? {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      headline: p.title,
      description: summary,
      datePublished: p.date,
      url: siteUrl(`/${p.slug}/`),
      author: { "@type": "Organization", name: SITE.name },
      publisher: { "@type": "Organization", name: SITE.name, logo: { "@type": "ImageObject", url: siteUrl(SITE.logo || "/logo/primary-logo.jpg") } },
    }
  : null;
const json = (o: any) => JSON.stringify(o).replace(/</g, "\\u003c");
---

<Base title={p.title} description={summary} type={p.date ? "article" : "website"} noindex={!!p.draft}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={json(crumbs)} />
    {article && <script type="application/ld+json" set:html={json(article)} />}
  </Fragment>
  <div class="wrap narrow">
    <p class="crumbs">
      <a href="/">Home</a> / {p.date && <><a href="/blog/">Blog</a> / </>}
      {p.title}
    </p>
    <div class="pagehead">
      <h1>{p.title}</h1>
      {date && <p class="meta">{date}</p>}
    </div>
    <article class="prose article">
      <Fragment set:html={html} />
    </article>
  </div>
</Base>
