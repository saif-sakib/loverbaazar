---
import Base from "../../layouts/Base.astro";
import { SITE, telOf, waOf } from "../../lib/shop";
---
<Base title="Contact us">
  <div class="wrap">
    <h1 style="margin-top:20px">Contact us</h1>
    <div class="two">
      <form class="panel" data-contact>
        <label class="field">Name<input name="name" required maxlength="100" autocomplete="name" /></label>
        <label class="field">Phone or email<input name="contact" required maxlength="100" /></label>
        <label class="field">Message<textarea name="body" rows="5" required minlength="5" maxlength="2000"></textarea></label>
        <input class="trap" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <p class="err"></p>
        <button class="btn small">Send message</button>
      </form>
      <aside class="panel">
        <p><b>Phone</b><br /><a class="link" href={`tel:${telOf(SITE.phone)}`}>{SITE.phone}</a></p>
        {SITE.whatsapp && <p><b>WhatsApp</b><br /><a class="link" href={waOf(SITE.whatsapp)} rel="noopener">{SITE.whatsapp}</a></p>}
        <p><b>Email</b><br /><a class="link" href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
        {SITE.address && <p><b>Address</b><br />{SITE.address}</p>}
        {SITE.hours && <p><b>Opening hours</b><br />{SITE.hours}</p>}
      </aside>
    </div>
  </div>
</Base>
