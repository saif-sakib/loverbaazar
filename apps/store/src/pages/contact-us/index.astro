---
import Base from "../../layouts/Base.astro";
import { jsonLd } from "../../lib/seo";
import { SITE, siteUrl, spacedSiteName, telOf, waOf } from "../../lib/shop";

const contactTitle = SITE.address ? `Contact Us — ${SITE.address}` : "Contact us";
const contactDesc = `Contact ${spacedSiteName}${SITE.address ? ` in ${SITE.address} (Jessore)` : ""} by phone (${SITE.phone}), WhatsApp, or email for online shopping, product details, and home delivery across Jashore and Bangladesh.`;
const crumbs = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: siteUrl("/") },
    { "@type": "ListItem", position: 2, name: "Contact us" },
  ],
};
const contactPageLd = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  name: contactTitle,
  description: contactDesc,
  url: siteUrl("/contact-us/"),
  mainEntity: { "@id": siteUrl("/#store") },
};
---

<Base title={contactTitle} description={contactDesc}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={jsonLd(crumbs)} />
    <script type="application/ld+json" set:html={jsonLd(contactPageLd)} />
  </Fragment>
  <div class="wrap">
    <div class="pagehead">
      <h1 class="title">Contact us</h1>
      <p>Questions about a product or an order? Send us a message or give us a call.</p>
    </div>
    <div class="two contact-layout">
      <section class="panel contact-details" aria-labelledby="shop-details-title">
        <h2 id="shop-details-title">{spacedSiteName}</h2>
        {SITE.address && <p>{SITE.address}</p>}
        {SITE.hours && <p class="meta">Opening hours · {SITE.hours}</p>}
        <div class="contact-actions">
          {SITE.phone && <a class="btn" href={`tel:${telOf(SITE.phone)}`}>Call {SITE.phone}</a>}
          {SITE.whatsapp && <a class="btn ghost" href={waOf(SITE.whatsapp)} rel="noopener">Message on WhatsApp</a>}
        </div>
        {SITE.email && <p><a class="link" href={`mailto:${SITE.email}`}>{SITE.email}</a></p>}
        <div class="purchase-links contact-links">
          <a class="link" href="/track/">Track your order</a>
          <a class="link" href="/how-to-buy/#delivery">Delivery information</a>
        </div>
      </section>
      <form class="panel" method="post" data-contact>
        <h2>Send a message</h2>
        <label class="field">
          Name
          <input name="name" required maxlength="100" autocomplete="name" />
        </label>
        <label class="field">
          Phone or email
          <input name="contact" required maxlength="100" />
        </label>
        <label class="field">
          Message<textarea name="body" rows="5" required minlength="5" maxlength="2000"></textarea>
        </label>
        <input class="trap" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <p class="err" role="alert" tabindex="-1"></p>
        <button class="btn small">Send message</button>
      </form>
    </div>
  </div>
</Base>
