---
import Base from "../../layouts/Base.astro";
import { jsonLd } from "../../lib/seo";
import { LIVE, SITE, siteUrl, spacedSiteName, taka, telOf, waOf } from "../../lib/shop";

const contactTitle = SITE.address ? `Contact Us — ${SITE.address}` : "Contact us";
const contactDesc = `Contact ${spacedSiteName}${SITE.address ? ` in ${SITE.address} (Jessore)` : ""} by phone (${SITE.phone}), WhatsApp, or email for online shopping, product details, and home delivery across Jashore and Bangladesh.`;
const crumbs = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: siteUrl("/") },
    { "@type": "ListItem", position: 2, name: "Contact us" },
  ],
};
const contactPageLd = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  name: contactTitle,
  description: contactDesc,
  url: siteUrl("/contact-us/"),
  mainEntity: { "@id": siteUrl("/#store") },
};
---

<Base title={contactTitle} description={contactDesc}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={jsonLd(crumbs)} />
    <script type="application/ld+json" set:html={jsonLd(contactPageLd)} />
  </Fragment>
  <div class="wrap">
    <div class="pagehead">
      <h1 class="title">Contact us</h1>
      <p>Questions about a product or an order? Send us a message or give us a call.</p>
    </div>
    <div class="two">
      <form class="panel" data-contact>
        <label class="field">
          Name
          <input name="name" required maxlength="100" autocomplete="name" />
        </label>
        <label class="field">
          Phone or email
          <input name="contact" required maxlength="100" />
        </label>
        <label class="field">
          Message<textarea name="body" rows="5" required minlength="5" maxlength="2000"></textarea>
        </label>
        <input class="trap" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <p class="err" role="alert" tabindex="-1"></p>
        <button class="btn small">Send message</button>
      </form>
      <aside class="panel">
        <p>
          <b>Phone</b>
          <br />
          <a class="link" href={`tel:${telOf(SITE.phone)}`}>
            {SITE.phone}
          </a>
        </p>
        {SITE.whatsapp && (
          <p>
            <b>WhatsApp</b>
            <br />
            <a class="link" href={waOf(SITE.whatsapp)} rel="noopener">
              {SITE.whatsapp}
            </a>
          </p>
        )}
        <p>
          <b>Email</b>
          <br />
          <a class="link" href={`mailto:${SITE.email}`}>
            {SITE.email}
          </a>
        </p>
        {SITE.address && (
          <p>
            <b>Address</b>
            <br />
            {SITE.address}
          </p>
        )}
        {SITE.hours && (
          <p>
            <b>Opening hours</b>
            <br />
            {SITE.hours}
          </p>
        )}
        {LIVE.delivery?.length > 0 && (
          <p>
            <b>Delivery</b>
            <br />
            {LIVE.delivery.map((z: any, i: number) => (
              <>
                {i > 0 && <br />}
                {z.label}: {Number(z.fee) > 0 && !(LIVE.freeOver > 0) ? taka(z.fee) : Number(z.fee) === 0 ? "Free" : `${taka(z.fee)} (free over ${taka(LIVE.freeOver)})`}
                {z.days && ` (${z.days})`}
              </>
            ))}
          </p>
        )}
        <p>
          <a class="link" href="/online-shopping-jashore/">Online shopping in Jashore</a>
        </p>
      </aside>
    </div>
  </div>
</Base>
