---
import Base from "../../layouts/Base.astro";
import { say } from "../../lib/shop";
---

<Base title={say("cartHeading")} noindex>
  <div class="wrap">
    <div class="pagehead">
      <h1 class="title">{say("cartHeading")}</h1>
    </div>
    <div class="two">
      <div class="panel" data-cart>
        Loading…
      </div>
      <aside class="panel">
        <div class="row total flush">
          <span>Subtotal</span>
          <span data-sub>৳0</span>
        </div>
        <p class="meta" data-free>
          {say("cartNote")}
        </p>
        <a class="btn small center" href="/checkout/" data-to-checkout hidden>
          Proceed to checkout
        </a>
      </aside>
    </div>
  </div>
</Base>
