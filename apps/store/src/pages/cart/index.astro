---
import Base from "../../layouts/Base.astro";
---

<Base title="Your cart" noindex>
  <div class="wrap">
    <div class="pagehead">
      <h1 class="title">Your cart</h1>
    </div>
    <div class="two">
      <div class="panel" data-cart>
        Loading…
      </div>
      <aside class="panel">
        <div class="row total flush">
          <span>Subtotal</span>
          <span data-sub>৳0</span>
        </div>
        <p class="meta" data-free>
          Delivery is added at checkout.
        </p>
        <a class="btn small center" href="/checkout/" data-to-checkout hidden>
          Proceed to checkout
        </a>
      </aside>
    </div>
  </div>
</Base>
