---
import { jsonLd, priceBounds, recordSEO, tagSeoTitle } from "../../lib/seo";
import Base from "../../layouts/Base.astro";
import Grid from "../../components/Grid.astro";
import { tags, products, fileSlug, siteUrl, spacedSiteName, taka } from "../../lib/shop";
export const getStaticPaths = () => tags.map((t) => ({ params: { slug: fileSlug(t.slug) }, props: { t } }));
const { t } = Astro.props;
const items = products.filter((p) => p.tags.includes(t.slug));
const bounds = priceBounds(items);
const title = tagSeoTitle(t.name, items.length);
const fallbackDesc = items.length > 0 && bounds.min > 0
  ? `Compare ${items.length} ${t.name} products in Bangladesh starting from ${taka(bounds.min)} at ${spacedSiteName}. Cash on delivery available.`
  : `Browse products tagged ${t.name} at ${spacedSiteName}. Compare prices and availability.`;
const seo = recordSEO(t, fallbackDesc);
const thin = items.length < 3 && !seo.seoTitle;
const crumbs = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: siteUrl("/") },
    { "@type": "ListItem", position: 2, name: "Shop", item: siteUrl("/shop/") },
    { "@type": "ListItem", position: 3, name: t.name },
  ],
};
---

<Base
  title={title}
  {...seo}
  noindex={seo.noindex || !items.length || thin}
  preconnectCloudinary
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={jsonLd(crumbs)} />
  </Fragment>
  <div class="wrap">
    <p class="crumbs">
      <a href="/">Home</a> / <a href="/shop/">Shop</a> / {t.name}
    </p>
    <div class="pagehead">
      <h1>{t.name}</h1>
    </div>
    {items.length ? <Grid items={items} /> : <div class="empty"><p>No products here yet. See everything else we sell in the shop.</p><a class="btn" href="/shop/">Shop all</a></div>}
  </div>
</Base>
