---
import Base from "../../layouts/Base.astro";
import Grid from "../../components/Grid.astro";
import { tags, products, fileSlug } from "../../lib/shop";
export const getStaticPaths = () => tags.map((t) => ({ params: { slug: fileSlug(t.slug) }, props: { t } }));
const { t } = Astro.props;
const items = products.filter((p) => p.tags.includes(t.slug));
---

<Base title={t.name} noindex={!items.length}>
  <div class="wrap">
    <p class="crumbs">
      <a href="/">Home</a> / <a href="/shop/">Shop</a> / {t.name}
    </p>
    <div class="pagehead">
      <h1>{t.name}</h1>
    </div>
    {items.length ? <Grid items={items} /> : <div class="empty"><p>No products here yet. See everything else we sell in the shop.</p><a class="btn" href="/shop/">Shop all</a></div>}
  </div>
</Base>
