{ "name": "loverbaazar", "main": "../../edge/worker.js", "compatibility_date": "2026-11-01",
  "triggers": { "crons": ["*/10 * * * *"] },
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "404-page", "run_worker_first": ["/api/*", "/wp-content/uploads/*"] },
  "vars": { "API_ORIGIN": "https://REPLACE-ME.onrender.com", "IMAGE_BASE": "" } }
